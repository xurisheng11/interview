/* 题目详情页样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.question-type {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.question-type.technical {
  background: #e6f7ff;
  color: #1890ff;
}

.question-type.behavioral {
  background: #fff7e6;
  color: #fa8c16;
}

.question-type.hr {
  background: #f9f0ff;
  color: #722ed1;
}

.question-type.project {
  background: #f6ffed;
  color: #52c41a;
}

.question-difficulty {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.question-difficulty.easy {
  background: #d9f7be;
  color: #52c41a;
}

.question-difficulty.medium {
  background: #ffe58f;
  color: #faad14;
}

.question-difficulty.hard {
  background: #ffccc7;
  color: #ff4d4f;
}

.question-content {
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 1.6;
  font-weight: 500;
}

.question-meta {
  display: flex;
  gap: 32rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

/* 内容区块 */
.section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.answer-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 24rpx;
}

.btn-copy {
  width: 200rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.hint-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 要点列表 */
.key-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.point-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  background: #f6ffed;
  border-radius: 12rpx;
}

.point-icon {
  color: #52c41a;
  font-size: 28rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.point-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 误区列表 */
.mistakes-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mistake-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  background: #fff1f0;
  border-radius: 12rpx;
}

.mistake-icon {
  color: #ff4d4f;
  font-size: 28rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.mistake-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

/* 相关题目 */
.related-list {
  display: flex;
  flex-direction: column;
}

.related-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid #f5f5f5;
}

.related-item:last-child {
  border-bottom: none;
}

.related-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-like {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 180rpx;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  border: none;
}

.btn-like.active {
  background: #fff1f0;
  color: #ff4d4f;
}

.icon {
  font-size: 32rpx;
}

.btn-practice {
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
