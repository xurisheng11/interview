/* 公司面试知识库页 */

/* 搜索区 */
.search-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.search-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
}

.search-desc {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  margin: 12rpx 0 28rpx;
  line-height: 1.6;
}

.search-input {
  background: var(--bg-input, #f5f7fa);
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.input-placeholder {
  color: #b0b7c3;
}

.job-trigger {
  background: var(--bg-input, #f5f7fa);
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.job-trigger .placeholder {
  color: #b0b7c3;
}

.picker-arrow {
  color: #b0b7c3;
  font-size: 30rpx;
}

.search-btn {
  width: 100%;
}

.hot-companies {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  align-items: center;
  margin-top: 24rpx;
}

.hot-label {
  font-size: 24rpx;
  color: #888;
}

.hot-tag {
  background: #fff;
  color: #555;
  border: 2rpx solid #e8eef7;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(20, 45, 90, 0.04);
}

/* 加载中 */
.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
}

.loading-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
  animation: bounce 1s infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.loading-text {
  font-size: 28rpx;
  color: #555;
  margin-bottom: 28rpx;
}

.loading-company {
  font-weight: 600;
  color: var(--brand);
}

.loading-bar {
  max-width: 400rpx;
  margin: 0 auto;
  height: 12rpx;
  background: #eef2f8;
  border-radius: 8rpx;
  overflow: hidden;
}

.loading-bar-fill {
  height: 100%;
  background: var(--gradient-brand);
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

/* 结果头部 */
.result-header {
  position: relative;
  margin-bottom: 24rpx;
  padding-left: 24rpx;
}

.result-header::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: var(--gradient-brand);
}

.result-company {
  font-size: 40rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #3d7eff 0%, #0958d9 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.result-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.result-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  background: var(--brand-light);
  color: var(--brand);
}

.result-tag.diff {
  background: #fff7e6;
  color: #d48806;
}

.process-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
}

/* 技巧列表 */
.tips-list {
  display: flex;
  flex-direction: column;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.tip-item:last-child {
  border-bottom: none;
}

.tip-num {
  background: var(--gradient-brand);
  color: #fff;
  border-radius: 50%;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

/* 筛选 */
.filter-tabs {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0 24rpx;
}

.filter-tab {
  font-size: 24rpx;
  color: #666;
  background: #f5f7fa;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}

.filter-tab.active {
  background: var(--brand-bg);
  color: var(--brand);
  font-weight: 600;
  border-color: var(--brand-light);
}

/* 题目列表：每道题独立浅底卡片，提示可点击 */
.questions-list {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.question-item {
  padding: 20rpx 24rpx;
  background: #fafcff;
  border: 2rpx solid #eef2f8;
  border-radius: 16rpx;
}

.q-pressed {
  background: var(--brand-bg);
  border-color: var(--brand-light);
}

.q-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.q-num {
  background: #f0f3f8;
  color: #7a8699;
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

/* 题型胶囊：技术=紫、行为=橙，与蓝色主色区分层次 */
.q-type {
  font-size: 20rpx;
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.q-type.tech {
  background: linear-gradient(135deg, #f4ebff 0%, #e8d8ff 100%);
  color: #722ed1;
  border: 2rpx solid #d3adf7;
}

.q-type.behavior {
  background: linear-gradient(135deg, #fff7e6 0%, #ffeccc 100%);
  color: #d46b08;
  border: 2rpx solid #ffd591;
}

.q-tag {
  font-size: 20rpx;
  padding: 3rpx 14rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8a94a6;
  border: 2rpx solid #eef0f4;
}

.q-arrow {
  margin-left: auto;
  color: var(--brand-light);
  font-size: 30rpx;
  font-weight: 700;
}

.q-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
  padding: 20rpx 0 8rpx;
}

.all-loaded {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 16rpx 0 4rpx;
}

.interview-btn {
  margin-bottom: 40rpx;
}

/* 空状态引导 */
.guide-wrap {
  text-align: center;
  padding: 80rpx 0;
}

.guide-icon {
  font-size: 100rpx;
}

.guide-text {
  font-size: 28rpx;
  color: #888;
  margin: 24rpx 0 40rpx;
}

.guide-examples {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.example-card {
  flex: 1;
  min-width: 44%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 2rpx solid #e8eef7;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: left;
  box-shadow: var(--shadow-card);
}

.example-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--gradient-brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.example-body {
  flex: 1;
  min-width: 0;
}

.example-company {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.example-desc {
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
}

.example-arrow {
  color: #c5cedb;
  font-size: 34rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* 题目详情弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.question-popup {
  position: relative;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 44rpx 32rpx 36rpx;
}

/* 顶部拖拽把手，提示这是可关闭弹层 */
.question-popup::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #e3e9f2;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.popup-close {
  font-size: 26rpx;
  color: #7a8699;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #f0f3f8;
}

.popup-question {
  font-size: 30rpx;
  color: #111;
  line-height: 1.7;
  font-weight: 500;
}

.popup-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.answer-section {
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f0f2f6;
}

.answer-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 20rpx;
}

.answer-placeholder {
  text-align: center;
  padding: 30rpx 0;
}

.answer-placeholder .btn-primary {
  width: 80%;
}

.answer-loading {
  text-align: center;
  color: #888;
  font-size: 26rpx;
  padding: 30rpx 0;
}

.answer-content {
  font-size: 26rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-wrap;
  background: #f8fafd;
  border-left: 6rpx solid var(--brand-light);
  border-radius: 4rpx 16rpx 16rpx 4rpx;
  padding: 24rpx;
}

.answer-empty {
  color: #bbb;
  font-size: 26rpx;
}
