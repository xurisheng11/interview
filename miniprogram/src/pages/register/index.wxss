/* 注册页面样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx 32rpx;
}

.form {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: #bbb;
}

/* 协议 */
.agreement {
  margin-bottom: 40rpx;
  padding: 0 16rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 8rpx;
}

.agreement-link {
  font-size: 26rpx;
  color: #1890ff;
  margin-left: 4rpx;
}

/* 注册按钮 */
.btn-register {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.btn-register[disabled] {
  background: #d9d9d9;
  box-shadow: none;
}

/* 登录链接 */
.login-link {
  text-align: center;
  margin-top: 40rpx;
}

.text {
  font-size: 28rpx;
  color: #666;
}

.link {
  font-size: 28rpx;
  color: #1890ff;
  margin-left: 8rpx;
}
