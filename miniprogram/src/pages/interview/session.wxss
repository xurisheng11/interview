/* 面试进行页样式 */
.container {
  min-height: 100vh;
  background: #1a1a1a;
  padding: 0 0 200rpx 0;
  box-sizing: border-box;
}

/* 顶部进度条 */
.progress-bar {
  padding: 24rpx 32rpx;
  background: #2a2a2a;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.timer-text {
  font-size: 32rpx;
  color: #1890ff;
  font-weight: 600;
  font-family: monospace;
}

.progress-track {
  height: 8rpx;
  background: #3a3a3a;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff 0%, #52c41a 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 问题卡片 */
.question-card {
  margin: 24rpx 32rpx;
  background: #2a2a2a;
  border-radius: 24rpx;
  padding: 32rpx;
}

.question-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.question-type-tag {
  padding: 8rpx 20rpx;
  background: #1890ff;
  border-radius: 8rpx;
}

.question-type-tag text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.question-difficulty {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.question-difficulty.easy {
  background: #d9f7be;
  color: #52c41a;
}

.question-difficulty.medium {
  background: #ffe58f;
  color: #faad14;
}

.question-difficulty.hard {
  background: #ffccc7;
  color: #ff4d4f;
}

.question-content {
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  color: #fff;
  line-height: 1.6;
  font-weight: 500;
}

.question-hint {
  display: flex;
  align-items: flex-start;
  background: #3a3a3a;
  border-radius: 12rpx;
  padding: 20rpx;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.5;
}

/* 答案输入区 */
.answer-section {
  margin: 0 32rpx 24rpx 32rpx;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.answer-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.answer-tips {
  font-size: 24rpx;
  color: #888;
}

.answer-input {
  width: 100%;
  height: 280rpx;
  padding: 24rpx;
  background: #2a2a2a;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: #fff;
  line-height: 1.6;
  box-sizing: border-box;
}

.answer-input::placeholder {
  color: #666;
}

.answer-input.recording {
  border: 2rpx solid #ff4d4f;
}

.answer-footer {
  text-align: right;
  padding: 12rpx 0;
}

.char-count {
  font-size: 24rpx;
  color: #666;
}

/* 录音区域：横向紧凑卡片 */
.record-section {
  margin: 0 32rpx 32rpx 32rpx;
  padding: 24rpx;
  background: #2a2a2a;
  border-radius: 24rpx;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-status-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-status {
  font-size: 28rpx;
  color: #ddd;
  font-weight: 500;
}

.record-status.on {
  color: #ff4d4f;
}

.record-sub-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #777;
}

/* 录音中的实时识别文本反馈 */
.record-live {
  margin: 20rpx 0 0;
  padding: 16rpx 20rpx;
  background: #222;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #ddd;
  text-align: left;
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ff4d4f;
  border-radius: 50%;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.record-time {
  font-family: monospace;
  font-size: 26rpx;
  color: #ff4d4f;
}

.btn-record {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 固定圆形尺寸：清零 button 默认内边距/外边距，防止被撑成椭圆 */
  flex: 0 0 112rpx;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 112rpx;
  min-height: 112rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  border: none;
  background: #3a3a3a;
  box-sizing: border-box;
}

.btn-record::after {
  border: none;
}

.btn-record.start {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.35);
}

.btn-record.stop {
  background: linear-gradient(135deg, #666 0%, #888 100%);
}

.record-icon {
  font-size: 44rpx;
  line-height: 1;
}

.btn-play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  padding: 0;
  margin: 0;
  background: #1890ff;
  border-radius: 50%;
  border: none;
  font-size: 30rpx;
  color: #fff;
  box-sizing: border-box;
}

.btn-play::after {
  border: none;
}

/* 底部操作区：三列 grid，列宽由网格强制约束，不受 button 默认样式影响 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: grid;
  grid-template-columns: 216rpx 1fr 216rpx;
  gap: 20rpx;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(26, 26, 26, 0.94);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.35);
}

.btn-prev, .btn-next {
  /* 宽度 100% 填满 grid 列 + min-width:0 允许收缩，双保险防溢出 */
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 88rpx;
  padding: 0;
  margin: 0;
  background: #333;
  border: 1rpx solid #444;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.btn-prev text, .btn-next text {
  white-space: nowrap;
  font-size: 28rpx;
}

/* 清除微信 button 默认 ::after 边框 */
.btn-prev::after, .btn-next::after, .btn-skip::after {
  border: none;
}

.btn-prev.disabled {
  opacity: 0.4;
}

.btn-next {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
  font-weight: 500;
}

.btn-center {
  min-width: 0;
  display: flex;
  justify-content: center;
}

.btn-skip {
  padding: 0 40rpx;
  height: 72rpx;
  background: transparent;
  border: 2rpx solid #4a4a4a;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #999;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 按压反馈 */
.btn-prev:active, .btn-next:active, .btn-skip:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 完成弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  padding: 60rpx 40rpx;
  background: #2a2a2a;
  border-radius: 24rpx;
  text-align: center;
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.modal-desc {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 32rpx;
}

.modal-progress {
  height: 8rpx;
  background: #3a3a3a;
  border-radius: 4rpx;
  overflow: hidden;
}

.modal-progress-bar {
  height: 100%;
  width: 30%;
  background: linear-gradient(90deg, #1890ff 0%, #52c41a 100%);
  border-radius: 4rpx;
  animation: loading 1.5s ease-in-out infinite;
}

@keyframes loading {
  0% { width: 0%; margin-left: 0; }
  50% { width: 60%; margin-left: 20%; }
  100% { width: 0%; margin-left: 100%; }
}

/* ============ 视频面试：摄像头悬浮窗 ============ */
.camera-float {
  position: fixed;
  top: 150rpx;
  right: 24rpx;
  width: 220rpx;
  height: 300rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.35);
  background: #000;
  z-index: 100;
}

.camera-view {
  width: 100%;
  height: 100%;
}

.camera-badge {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  font-size: 18rpx;
  color: #fff;
}

.camera-rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ff4d4f;
  animation: camera-blink 1.2s infinite;
}

@keyframes camera-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.2; }
}

.camera-min {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
}

.camera-restore {
  position: fixed;
  top: 150rpx;
  right: 24rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.45);
  z-index: 100;
}

.camera-warn {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(255, 152, 0, 0.16);
  color: #ffb066;
  font-size: 24rpx;
  border-radius: 12rpx;
}
