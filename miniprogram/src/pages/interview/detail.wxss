/* 面试详情页面样式 */
.container {
  padding: 24rpx;
}

.loading, .empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  margin-right: 16rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-badge.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-badge.in_progress {
  background: #e6f7ff;
  color: #1890ff;
}

.status-badge.completed {
  background: #f6ffed;
  color: #52c41a;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 评分区块 */
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.score-overview {
  display: flex;
  align-items: center;
}

.main-score {
  display: flex;
  align-items: baseline;
  margin-right: 48rpx;
}

.score-num {
  font-size: 72rpx;
  font-weight: 600;
}

.score-num.excellent {
  color: #52c41a;
}

.score-num.good {
  color: #1890ff;
}

.score-num.warning {
  color: #fa8c16;
}

.score-unit {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

.score-detail {
  flex: 1;
}

.score-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #666;
}

.score-item-value {
  font-weight: 600;
}

.score-item-value.excellent {
  color: #52c41a;
}

.score-item-value.good {
  color: #1890ff;
}

.score-item-value.warning {
  color: #fa8c16;
}

/* 回答详情 */
.answer-item {
  padding: 24rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.answer-item:last-child {
  border-bottom: none;
}

.question, .answer {
  margin-bottom: 16rpx;
}

.q-label, .a-label {
  display: inline-block;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #e6f7ff;
  color: #1890ff;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.a-label {
  background: #f6ffed;
  color: #52c41a;
}

.q-text, .a-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.answer-score {
  text-align: right;
  font-size: 24rpx;
  color: #fa8c16;
}

/* AI 点评 */
.feedback-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 操作按钮 */
.action-bar {
  margin-top: 24rpx;
}

.btn-continue {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.completed-actions {
  display: flex;
  gap: 20rpx;
}

.btn-action {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-action.primary {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
}

.btn-action.secondary {
  background: #f5f5f5;
  color: #666;
}

.copy-section {
  margin-top: 16rpx;
}

.btn-copy {
  width: 100%;
  height: 80rpx;
  background: #fff;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1px solid #ddd;
}
