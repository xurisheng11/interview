<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{!interview}}" class="empty-state">
    <text>面试记录不存在</text>
  </view>

  <view wx:else>
    <!-- 头部信息卡 -->
    <view class="card head-card anim-fade-in">
      <view class="head-top">
        <view class="head-title-wrap">
          <text class="head-title">{{view.title}}</text>
          <text class="head-subtitle">{{view.subtitle}} · {{view.roundText}} · {{view.modeText}}</text>
        </view>
        <view class="status-badge {{interview.status}}">
          <view class="status-dot"></view>
          <text>{{view.statusText}}</text>
        </view>
      </view>
      <view class="head-meta">
        <view class="meta-chip">
          <text class="meta-chip-label">难度</text>
          <text class="meta-chip-value">{{view.difficultyText}}</text>
        </view>
        <view class="meta-chip">
          <text class="meta-chip-label">题目数</text>
          <text class="meta-chip-value">{{view.questionCount}}</text>
        </view>
        <view class="meta-chip">
          <text class="meta-chip-label">用时</text>
          <text class="meta-chip-value">{{view.durationText || '--'}}</text>
        </view>
        <view class="meta-chip">
          <text class="meta-chip-label">时间</text>
          <text class="meta-chip-value">{{view.startTimeText}}</text>
        </view>
      </view>
    </view>

    <!-- 综合评分 -->
    <view class="card anim-fade-in" wx:if="{{report}}">
      <text class="section-title">🏆 综合评分</text>
      <view class="score-hero">
        <view class="score-ring {{view.scoreClass}}">
          <text class="score-ring-num">{{view.totalScore}}</text>
          <text class="score-ring-unit">分</text>
        </view>
        <view class="score-side">
          <view class="grade-tag {{view.scoreClass}}">{{view.grade}}</view>
          <view class="pass-tag {{view.passClass}}">
            <text>{{view.passText}}</text>
            <text wx:if="{{view.passReason}}" class="pass-reason">{{view.passReason}}</text>
          </view>
          <text class="score-count">作答 {{view.answeredCount}} 题 · 跳过 {{view.skippedCount}} 题</text>
        </view>
      </view>

      <!-- 模块得分 -->
      <view wx:if="{{view.moduleScores.length > 0}}" class="module-section">
        <text class="subsection-title">知识点模块得分</text>
        <view wx:for="{{view.moduleScores}}" wx:key="module" class="module-item">
          <view class="module-top">
            <text class="module-name">{{item.module}}</text>
            <text class="module-score {{item.cls}}">{{item.avgText}}<text class="module-level">{{item.level}} · {{item.count}}题</text></text>
          </view>
          <view class="module-bar">
            <view class="module-bar-fill {{item.cls}}" style="width: {{item.width}}%"></view>
          </view>
        </view>
      </view>

      <!-- 视频面试附加指标 -->
      <view wx:if="{{view.videoMetrics.length > 0}}" class="video-metrics">
        <view wx:for="{{view.videoMetrics}}" wx:key="label" class="video-metric">
          <text class="video-metric-value">{{item.value}}</text>
          <text class="video-metric-label">{{item.label}}</text>
        </view>
      </view>
      <view wx:if="{{view.expressionSummary}}" class="expression-box">
        <text class="expression-title">🎤 表达能力评价</text>
        <text class="expression-text">{{view.expressionSummary}}</text>
      </view>
    </view>

    <!-- 逐题点评 -->
    <view class="card anim-fade-in" wx:if="{{view.questions.length > 0}}">
      <text class="section-title">📝 逐题点评</text>
      <view wx:for="{{view.questions}}" wx:key="idx" class="q-card">
        <view class="q-head">
          <view class="q-index">Q{{item.idx}}</view>
          <view class="q-tags">
            <text wx:if="{{item.difficulty}}" class="q-diff">{{item.difficulty}}</text>
            <text wx:if="{{item.tagsText}}" class="q-tag">{{item.tagsText}}</text>
          </view>
          <view class="q-score {{item.scoreCls}}">
            <text wx:if="{{item.answered}}">{{item.scoreText}}分</text>
            <text wx:else>已跳过</text>
          </view>
        </view>

        <text class="q-content">{{item.content}}</text>

        <view class="q-answer" wx:if="{{item.answered}}">
          <text class="q-block-label">我的回答</text>
          <text class="q-answer-text">{{item.userAnswer}}</text>
        </view>
        <view class="q-skipped-hint" wx:else>
          <text>本题未作答，计 0 分</text>
        </view>

        <view wx:if="{{item.pros.length > 0}}" class="q-pros">
          <view wx:for="{{item.pros}}" wx:for-item="p" wx:key="*this" class="pro-line">
            <text class="pro-icon">✅</text>
            <text class="pro-text">{{p}}</text>
          </view>
        </view>
        <view wx:if="{{item.cons.length > 0}}" class="q-cons">
          <view wx:for="{{item.cons}}" wx:for-item="c" wx:key="*this" class="con-line">
            <text class="con-icon">⚠️</text>
            <text class="con-text">{{c}}</text>
          </view>
        </view>
        <view wx:if="{{item.expressionFeedback}}" class="q-expr">
          <text class="expr-icon">🗣</text>
          <text class="expr-text">{{item.expressionFeedback}}</text>
        </view>

        <view wx:if="{{item.referenceAnswer}}" class="ref-toggle" hover-class="btn-press"
          bindtap="toggleRef" data-index="{{index}}">
          <text>💡 参考答案</text>
          <text class="ref-arrow {{item._refOpen ? 'open' : ''}}">▾</text>
        </view>
        <view wx:if="{{item.referenceAnswer && item._refOpen}}" class="ref-body">
          <text>{{item.referenceAnswer}}</text>
        </view>
      </view>
    </view>

    <!-- AI 综合评价 -->
    <view class="card anim-fade-in" wx:if="{{view.strengths.length > 0 || view.weaknesses.length > 0 || view.roadmap}}">
      <text class="section-title">🤖 AI 综合评价</text>

      <view wx:if="{{view.strengths.length > 0}}" class="ai-block">
        <text class="ai-block-title good-t">优势亮点</text>
        <view wx:for="{{view.strengths}}" wx:key="*this" class="ai-line">
          <text class="ai-dot good-d"></text>
          <text class="ai-line-text">{{item}}</text>
        </view>
      </view>

      <view wx:if="{{view.weaknesses.length > 0}}" class="ai-block">
        <text class="ai-block-title bad-t">待改进项</text>
        <view wx:for="{{view.weaknesses}}" wx:key="point" class="ai-weak">
          <view class="ai-line">
            <text class="ai-dot bad-d"></text>
            <text class="ai-line-text">{{item.point}}</text>
          </view>
          <text wx:if="{{item.suggestion}}" class="weak-sug">建议：{{item.suggestion}}</text>
          <text wx:if="{{item.resource}}" class="weak-res">资料：{{item.resource}}</text>
        </view>
      </view>

      <view wx:if="{{view.roadmap}}" class="ai-block">
        <text class="ai-block-title">提升路线</text>
        <text class="roadmap-text">{{view.roadmap}}</text>
      </view>
    </view>

    <!-- 报告未生成提示 -->
    <view class="card no-report anim-fade-in" wx:if="{{!report && view.isCompleted}}">
      <text>报告尚未生成，可能所有答案都未提交。重新完成一次带回答的面试即可生成完整点评。</text>
    </view>

    <!-- 操作区 -->
    <view class="action-bar">
      <button class="btn-continue" bindtap="continueInterview" hover-class="btn-brand-pressed"
        wx:if="{{!view.isCompleted}}">
        继续面试
      </button>

      <view class="completed-actions" wx:else>
        <view class="action-row">
          <button class="btn-act primary" hover-class="btn-brand-pressed" open-type="share" wx:if="{{report}}">
            <text class="btn-act-icon">🔗</text>
            <text class="btn-act-text">分享报告</text>
          </button>
          <button class="btn-act ghost" hover-class="btn-ghost-pressed" bindtap="downloadWord" wx:if="{{report}}">
            <text class="btn-act-icon">📄</text>
            <text class="btn-act-text">下载Word</text>
          </button>
        </view>
        <view class="btn-restart" hover-class="btn-restart-pressed" bindtap="restartInterview">
          <text class="btn-restart-icon">🔄</text>
          <text>用相同配置重新面试</text>
        </view>
      </view>
    </view>
  </view>
</view>
