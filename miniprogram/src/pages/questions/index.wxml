<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar anim-fade-in">
    <view class="search-input-wrapper">
      <view class="search-icon">
        <view class="search-icon-circle"></view>
        <view class="search-icon-handle"></view>
      </view>
      <input
        class="search-input"
        placeholder="搜索题目..."
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="category-tabs">
    <view
      wx:for="{{categories}}"
      wx:key="value"
      class="tab-item {{selectedCategory === item.value ? 'active' : ''}}"
      bindtap="selectCategory"
      data-value="{{item.value}}"
    >
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 题目列表 -->
  <view class="question-list" wx:if="{{questions.length > 0}}">
    <view
      wx:for="{{questions}}"
      wx:key="questionId"
      class="question-card anim-fade-in"
      hover-class="card-pressed"
      bindtap="viewQuestion"
      data-id="{{item.questionId}}"
    >
      <view class="card-header">
        <view class="question-type {{item.type}}">
          <text>{{item.typeName}}</text>
        </view>
        <view class="question-difficulty {{item.difficulty}}">
          <text>{{item.difficultyName}}</text>
        </view>
      </view>

      <view class="question-content">
        <text class="question-text">{{item.content}}</text>
      </view>

      <view class="card-footer">
        <view class="meta-info">
          <view class="meta-item">
            <view class="meta-dot d-blue"></view>
            <text>{{item.answerCount || 0}} 次练习</text>
          </view>
          <view class="meta-item">
            <view class="meta-dot d-orange"></view>
            <text>{{item.avgScore || 0}} 分</text>
          </view>
        </view>
        <view class="action-hint">
          <text class="collect-star {{item.isCollected ? 'on' : ''}}" catchtap="toggleCollect" data-id="{{item.questionId}}" data-index="{{index}}">{{item.isCollected ? '★' : '☆'}}</text>
          <text>查看详情 ›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon-wrap">
      <view class="empty-cube icon-cube">题</view>
    </view>
    <text class="empty-text">暂无相关题目</text>
    <text class="empty-desc">试试其他分类或关键词</text>
  </view>
</view>
