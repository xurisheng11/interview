/* 首页样式 */
.container {
  padding: 24rpx;
}

/* ============ 未登录 Hero ============ */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 72rpx;
}

.hero-badge {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(22, 119, 255, 0.35);
  position: relative;
}

.hero-badge::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  width: 44rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(-20deg);
}

.hero-badge-text {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.hero-desc {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 32rpx;
}

.hero-feature {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 28rpx;
  background: var(--brand-bg);
  border-radius: 999rpx;
}

.feature-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
}

.feature-text {
  font-size: 24rpx;
  color: var(--brand);
  letter-spacing: 1rpx;
}

.btn-login {
  width: 600rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);
}

.btn-login::after {
  border: none;
}

.btn-login:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.login-tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* ============ 用户卡片（品牌渐变） ============ */
.user-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.28);
}

/* 装饰光斑 */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.deco-1 {
  width: 260rpx;
  height: 260rpx;
  top: -110rpx;
  right: -60rpx;
}

.deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -60rpx;
  right: 180rpx;
  background: rgba(255, 255, 255, 0.08);
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

/* 头像白色描边 */
.avatar-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.35);
  margin-right: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: block;
}

.info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.role-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.role-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b7ffb7;
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx rgba(183, 255, 183, 0.9);
}

/* ============ 快捷操作 ============ */
.quick-actions {
  display: flex;
  justify-content: space-between;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 12rpx 0;
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.action-pressed {
  background: #f4f7fc;
  transform: scale(0.96);
}

.action-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

/* 顶部光泽 */
.action-icon::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 14rpx;
  width: 36rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(-20deg);
}

.bg-blue {
  background: linear-gradient(135deg, #52a9ff 0%, #0958d9 100%);
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-green {
  background: linear-gradient(135deg, #73d13d 0%, #389e0d 100%);
  box-shadow: 0 8rpx 20rpx rgba(82, 196, 26, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-orange {
  background: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  box-shadow: 0 8rpx 20rpx rgba(250, 173, 20, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-purple {
  background: linear-gradient(135deg, #b37feb 0%, #722ed1 100%);
  box-shadow: 0 8rpx 20rpx rgba(114, 46, 209, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-cyan {
  background: linear-gradient(135deg, #5cdbd3 0%, #08979c 100%);
  box-shadow: 0 8rpx 20rpx rgba(19, 194, 194, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-pink {
  background: linear-gradient(135deg, #ff85c0 0%, #c41d7f 100%);
  box-shadow: 0 8rpx 20rpx rgba(235, 47, 150, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-gold {
  background: linear-gradient(135deg, #ffd666 0%, #ad6800 100%);
  box-shadow: 0 8rpx 20rpx rgba(212, 136, 6, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-gray {
  background: linear-gradient(135deg, #bfbfbf 0%, #595959 100%);
  box-shadow: 0 8rpx 20rpx rgba(89, 89, 89, 0.24), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.icon-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
}

/* ============ 功能导航宫格 ============ */
.func-grid {
  display: flex;
  flex-wrap: wrap;
}

.func-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.func-item .action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin-bottom: 12rpx;
}

.func-item .icon-text {
  font-size: 34rpx;
}

.func-item .action-text {
  font-size: 24rpx;
}

/* ============ 统计数据 ============ */
.stats-card {
  padding: 40rpx 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1f6;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.v-blue {
  color: var(--brand);
}

.v-green {
  color: var(--success);
}

.v-orange {
  color: #ef9400;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

/* ============ 最近面试 ============ */
.interview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 16rpx;
  margin: 0 -16rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

.interview-item:last-child {
  border-bottom: none;
}

.item-pressed {
  background: #f4f7fc;
}

.interview-info {
  display: flex;
  flex-direction: column;
}

.interview-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.interview-time {
  font-size: 24rpx;
  color: var(--text-hint);
}

.interview-score {
  display: flex;
  align-items: baseline;
  padding: 8rpx 20rpx;
  background: var(--brand-bg);
  border-radius: 16rpx;
}

.score-value {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand);
}

.score-label {
  font-size: 24rpx;
  color: var(--brand);
  margin-left: 4rpx;
  opacity: 0.7;
}
