<view class="container">
  <!-- 头像区域（品牌渐变头部） -->
  <view class="avatar-section">
    <view class="deco-circle deco-1"></view>
    <view class="deco-circle deco-2"></view>
    <view class="avatar-wrapper" hover-class="avatar-pressed" bindtap="chooseAvatar">
      <image
        class="avatar"
        src="{{formData.avatar || '/assets/default-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="avatar-edit icon-cube">
        <text>换</text>
      </view>
    </view>
    <text class="avatar-tip">点击更换头像</text>
  </view>

  <!-- 基本信息 -->
  <view class="section anim-fade-in">
    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="nickname">
      <view class="row-left">
        <text class="row-label">昵称</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{formData.nickname || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="username">
      <view class="row-left">
        <text class="row-label">用户名</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{formData.username || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="phone">
      <view class="row-left">
        <text class="row-label">手机号</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{formData.phone || '未绑定'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="email">
      <view class="row-left">
        <text class="row-label">邮箱</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{formData.email || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 个人简介 -->
  <view class="section anim-fade-in">
    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="bio">
      <view class="row-left">
        <text class="row-label">个人简介</text>
      </view>
      <view class="row-right">
        <text class="row-value bio-text">{{formData.bio || '点击编辑'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 求职意向 -->
  <view class="section anim-fade-in">
    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="targetPosition">
      <view class="row-left">
        <text class="row-label">目标岗位</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{formData.targetPosition || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="input-row" hover-class="row-pressed" bindtap="editField" data-field="experience">
      <view class="row-left">
        <text class="row-label">工作年限</text>
      </view>
      <view class="row-right">
        <text class="row-value">{{formData.experience || '未设置'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="bottom-bar">
    <button class="btn-save" bindtap="saveProfile" loading="{{loading}}">
      保存修改
    </button>
  </view>
</view>
