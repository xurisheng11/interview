/* 题库页面样式 */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 24rpx 48rpx;
}

/* ============ 搜索栏 ============ */
.search-bar {
  padding: 8rpx 0 20rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
}

/* CSS 放大镜图标 */
.search-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.search-icon-circle {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #9aa3af;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon-handle {
  position: absolute;
  bottom: 2rpx;
  right: 0;
  width: 14rpx;
  height: 4rpx;
  background: #9aa3af;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.search-placeholder {
  color: #b8c0cc;
}

/* ============ 分类标签 ============ */
.category-tabs {
  display: flex;
  padding: 8rpx 8rpx 24rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.category-tabs::-webkit-scrollbar {
  display: none;
}

.tab-item {
  flex-shrink: 0;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
  box-shadow: 0 4rpx 12rpx rgba(20, 45, 90, 0.04);
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(22, 119, 255, 0.32);
}

/* ============ 题目卡片 ============ */
.question-list {
  padding: 0;
}

.question-card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  transition: all 0.15s ease;
}

.card-pressed {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(20, 45, 90, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.question-type {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.question-type.technical {
  background: var(--brand-bg);
  color: var(--brand);
}

.question-type.behavioral {
  background: #fff7e0;
  color: #ef9400;
}

.question-type.hr {
  background: #f6efff;
  color: var(--purple);
}

.question-type.project {
  background: #f0fbe4;
  color: var(--success);
}

.question-difficulty {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.question-difficulty.easy {
  background: #f0fbe4;
  color: var(--success);
}

.question-difficulty.medium {
  background: #fff7e0;
  color: #ef9400;
}

.question-difficulty.hard {
  background: #fff1f0;
  color: var(--danger);
}

.question-content {
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.meta-info {
  display: flex;
  gap: 28rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-hint);
}

.meta-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.d-blue {
  background: var(--brand);
}

.d-orange {
  background: #ef9400;
}

.action-hint {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 500;
}

.collect-star {
  font-size: 34rpx;
  line-height: 1;
  color: #c5ccd6;
}

.collect-star.on {
  color: #faad14;
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon-wrap {
  margin-bottom: 32rpx;
}

.empty-cube {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #d6e6ff 0%, #b3d1ff 100%);
  color: var(--brand);
  font-size: 56rpx;
  font-weight: 700;
  position: relative;
}

.empty-cube::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 22rpx;
  width: 40rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  transform: rotate(-20deg);
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}
