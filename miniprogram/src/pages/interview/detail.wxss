/* 面试详情/报告页 */
.container {
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 160rpx 0;
  color: var(--text-hint);
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  margin-bottom: 28rpx;
}

.subsection-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-sub);
  margin: 28rpx 0 16rpx;
}

/* ============ 头部信息卡 ============ */
.head-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.head-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.head-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-main);
}

.head-subtitle {
  font-size: 24rpx;
  color: var(--text-hint);
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #f2f4f7;
  color: var(--text-sub);
}

.status-badge.completed { background: #f0fbe4; color: var(--success); }
.status-badge.ongoing { background: var(--brand-bg); color: var(--brand); }
.status-badge.paused { background: #fff7e0; color: #ef9400; }

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.head-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.meta-chip {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  background: #f8fafd;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
}

.meta-chip-label {
  font-size: 22rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}

.meta-chip-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ============ 综合评分 ============ */
.score-hero {
  display: flex;
  align-items: center;
  gap: 36rpx;
}

.score-ring {
  flex-shrink: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 10rpx solid var(--brand);
  background: radial-gradient(circle at 50% 40%, #f4f9ff 0%, #ffffff 70%);
}

.score-ring-num {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--brand);
}

.score-ring-unit {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-left: 4rpx;
  align-self: flex-end;
  margin-bottom: 14rpx;
}

.score-ring.excellent { border-color: var(--success); }
.score-ring.excellent .score-ring-num { color: var(--success); }
.score-ring.good { border-color: var(--brand); }
.score-ring.good .score-ring-num { color: var(--brand); }
.score-ring.pass { border-color: #ef9400; }
.score-ring.pass .score-ring-num { color: #ef9400; }
.score-ring.warning { border-color: var(--danger); }
.score-ring.warning .score-ring-num { color: var(--danger); }

.score-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.grade-tag {
  align-self: flex-start;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--brand);
}

.grade-tag.excellent { background: var(--success); }
.grade-tag.good { background: var(--brand); }
.grade-tag.pass { background: #ef9400; }
.grade-tag.warning { background: var(--danger); }

.pass-tag {
  align-self: flex-start;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pass-tag.pass { color: var(--success); }
.pass-tag.pending { color: #ef9400; }
.pass-tag.fail { color: var(--danger); }

.pass-reason {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-hint);
}

.score-count {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 模块得分 */
.module-section { margin-top: 8rpx; }

.module-item { margin-bottom: 20rpx; }

.module-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.module-name {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 500;
}

.module-score {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.module-score.excellent { color: var(--success); }
.module-score.pass { color: #ef9400; }
.module-score.warning { color: var(--danger); }

.module-level {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-hint);
  margin-left: 10rpx;
}

.module-bar {
  height: 14rpx;
  background: #f0f3f7;
  border-radius: 7rpx;
  overflow: hidden;
}

.module-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  background: var(--gradient-brand);
  transition: width 0.6s ease;
}

.module-bar-fill.excellent { background: var(--gradient-green); }
.module-bar-fill.pass { background: var(--gradient-orange); }
.module-bar-fill.warning { background: linear-gradient(135deg, #ff7875, #cf1322); }

/* 视频指标 */
.video-metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.video-metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: #f8fafd;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
}

.video-metric-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand);
}

.video-metric-label {
  font-size: 20rpx;
  color: var(--text-hint);
}

.expression-box {
  margin-top: 24rpx;
  background: #f8fafd;
  border-radius: 16rpx;
  padding: 24rpx;
}

.expression-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.expression-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

/* ============ 逐题点评 ============ */
.q-card {
  background: #f8fafd;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.q-card:last-child { margin-bottom: 0; }

.q-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.q-index {
  flex-shrink: 0;
  width: 64rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: var(--gradient-brand);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.q-tags {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  overflow: hidden;
}

.q-diff {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-bg);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.q-tag {
  font-size: 20rpx;
  color: var(--text-hint);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.q-score {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  background: var(--brand-bg);
  color: var(--brand);
}

.q-score.excellent { background: #f0fbe4; color: var(--success); }
.q-score.good { background: var(--brand-bg); color: var(--brand); }
.q-score.pass { background: #fff7e0; color: #ef9400; }
.q-score.warning { background: #fff1f0; color: var(--danger); }
.q-score.none { background: #f2f4f7; color: var(--text-hint); }

.q-content {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.q-answer {
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.q-block-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-hint);
  margin-bottom: 8rpx;
}

.q-answer-text {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
  word-break: break-all;
}

.q-skipped-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.pro-line, .con-line {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.pro-text, .con-text {
  font-size: 24rpx;
  line-height: 1.6;
  flex: 1;
}

.pro-text { color: #2c8a3c; }
.con-text { color: #b56a12; }
.pro-icon, .con-icon { font-size: 22rpx; flex-shrink: 0; margin-top: 2rpx; }

.q-expr {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 8rpx;
}

.expr-icon { flex-shrink: 0; font-size: 22rpx; margin-top: 2rpx; }

.expr-text {
  font-size: 24rpx;
  color: var(--purple);
  line-height: 1.6;
  flex: 1;
}

.ref-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  background: #eef4ff;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
}

.ref-arrow {
  transition: transform 0.2s ease;
  font-size: 24rpx;
}

.ref-arrow.open { transform: rotate(180deg); }

.ref-body {
  margin-top: 4rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.8;
}

/* ============ AI 综合评价 ============ */
.ai-block { margin-bottom: 28rpx; }
.ai-block:last-child { margin-bottom: 0; }

.ai-block-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.good-t { color: #2c8a3c; }
.bad-t { color: #b56a12; }

.ai-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.ai-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 14rpx;
}

.good-d { background: var(--success); }
.bad-d { background: #ef9400; }

.ai-line-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.ai-weak { margin-bottom: 18rpx; }

.weak-sug {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  background: #f8fafd;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-top: 6rpx;
  line-height: 1.6;
}

.weak-res {
  display: block;
  font-size: 22rpx;
  color: var(--brand);
  margin-top: 8rpx;
  word-break: break-all;
}

.roadmap-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.8;
  background: #f8fafd;
  border-radius: 14rpx;
  padding: 22rpx;
}

/* 报告未生成 */
.no-report {
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1.7;
}

/* ============ 操作区 ============ */
.action-bar {
  margin-top: 8rpx;
}

.btn-continue {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--gradient-brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  border: none;
  box-shadow: 0 10rpx 28rpx rgba(22, 119, 255, 0.3);
}

.btn-continue::after { border: none; }

.completed-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-action {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-action::after { border: none; }

.btn-action.primary {
  background: var(--gradient-brand);
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(22, 119, 255, 0.3);
}

.btn-action.ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(22, 119, 255, 0.45);
}

.btn-action.secondary {
  background: #f2f4f7;
  color: var(--text-sub);
}

.btn-ghost-pressed { opacity: 0.75; transform: scale(0.99); }
.btn-brand-pressed { opacity: 0.85; transform: scale(0.99); }
