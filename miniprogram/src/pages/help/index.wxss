/* 帮助与反馈页面样式 */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 8rpx 24rpx 48rpx;
}

.section {
  margin-bottom: 28rpx;
}

/* 分组标题 */
.section-title {
  display: flex;
  align-items: center;
  padding: 24rpx 12rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #52a9ff, #0958d9);
  margin-right: 14rpx;
}

.item-pressed {
  background: #f4f7fc;
}

/* ============ FAQ 列表 ============ */
.faq-list {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  overflow: hidden;
}

.faq-item {
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-item.expanded {
  background: #fafcff;
}

.faq-header {
  display: flex;
  align-items: center;
  padding: 30rpx 30rpx;
}

.faq-q-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--brand-bg);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.faq-q {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}

.faq-arrow {
  font-size: 34rpx;
  color: #c5ccd6;
  margin-left: 16rpx;
  line-height: 1;
  transition: transform 0.25s ease;
}

.faq-arrow.open {
  transform: rotate(90deg);
  color: var(--brand);
}

.faq-answer {
  margin: 0 30rpx 28rpx 88rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.8;
  white-space: pre-wrap;
  background: #f4f7fc;
  border-radius: 16rpx;
}

/* ============ 教程列表 ============ */
.tutorial-list {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  overflow: hidden;
}

.tutorial-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

.tutorial-item:last-child {
  border-bottom: none;
}

.tutorial-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  margin-right: 24rpx;
  position: relative;
  flex-shrink: 0;
}

.tutorial-icon::after {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 12rpx;
  width: 26rpx;
  height: 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  transform: rotate(-20deg);
}

.t-blue {
  background: linear-gradient(135deg, #52a9ff 0%, #0958d9 100%);
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.22);
}

.t-green {
  background: linear-gradient(135deg, #73d13d 0%, #389e0d 100%);
  box-shadow: 0 6rpx 16rpx rgba(82, 196, 26, 0.22);
}

.t-orange {
  background: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  box-shadow: 0 6rpx 16rpx rgba(250, 173, 20, 0.22);
}

.tutorial-content {
  flex: 1;
}

.tutorial-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.tutorial-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
}

.arrow {
  font-size: 36rpx;
  color: #c5ccd6;
  line-height: 1;
}

/* ============ 反馈表单 ============ */
.feedback-form {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
}

.feedback-input {
  width: 100%;
  height: 220rpx;
  padding: 24rpx;
  background: #f8fafd;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.feedback-placeholder {
  color: #b8c0cc;
}

.feedback-footer {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 8rpx 20rpx;
}

.char-count {
  font-size: 24rpx;
  color: var(--text-hint);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  transform: scale(0.97);
  opacity: 0.92;
}

/* ============ 联系客服 ============ */
.contact-list {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  overflow: hidden;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-left {
  display: flex;
  align-items: center;
}

.contact-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  margin-right: 24rpx;
  position: relative;
}

.contact-icon::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  transform: rotate(-20deg);
}

.contact-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.contact-value {
  font-size: 26rpx;
  color: var(--text-hint);
}
