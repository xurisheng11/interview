/* 简历详情页面样式 */
.container {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.loading,
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-hint);
}

.btn-back {
  margin-top: 32rpx;
  width: 320rpx;
  height: 80rpx;
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(22, 119, 255, 0.45);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-back::after {
  border: none;
}

/* ============ 文件信息卡片 ============ */
.info-card {
  margin-bottom: 24rpx;
}

.resume-header {
  display: flex;
  align-items: center;
}

.resume-icon-lg-wrap {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafd;
  border-radius: 24rpx;
  margin-right: 24rpx;
}

.resume-icon-lg {
  font-size: 56rpx;
}

.resume-meta {
  flex: 1;
  min-width: 0;
}

.resume-filename-lg {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: #f2f4f7;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: currentColor;
}

.status-tag.pending {
  background: #fff7e0;
  color: #ef9400;
}

.status-tag.analyzing {
  background: #fff7e0;
  color: #ef9400;
}

.status-tag.done {
  background: #f0fbe4;
  color: var(--success);
}

.status-tag.failed {
  background: #fff1f0;
  color: var(--danger);
}

/* ============ 区块卡片 ============ */
.section-card {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--gradient-brand);
  margin-right: 16rpx;
}

.subsection-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  margin-top: 32rpx;
}

/* 重新分析按钮 */
.btn-retry {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: #fff7e0;
  color: #ef9400;
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

.btn-press {
  transform: scale(0.96);
  opacity: 0.88;
}

/* ============ 分析状态占位 ============ */
.status-box {
  text-align: center;
  padding: 60rpx 20rpx;
}

.status-box-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.status-box-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-hint);
}

.status-box-text-fail {
  color: var(--danger);
}

/* ============ 总分展示 ============ */
.total-score-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0;
}

.score-circle {
  display: flex;
  align-items: baseline;
  justify-content: center;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #f8fafd;
  border: 6rpx solid #e8ecf2;
  margin-bottom: 16rpx;
}

.score-circle-num {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.1;
}

.score-circle-num.score-high {
  color: var(--success);
}

.score-circle-num.score-mid {
  color: var(--brand);
}

.score-circle-num.score-low {
  color: #ef9400;
}

.score-circle-num.score-none {
  color: #c5ccd6;
}

.score-circle-unit {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-left: 4rpx;
}

.total-score-label {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ============ 维度评分 ============ */
.dimensions-section {
  margin-top: 16rpx;
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dimension-item {
  padding: 0;
}

.dimension-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dimension-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
}

.dimension-score {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand);
}

.dimension-bar {
  height: 14rpx;
  background: #eef1f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.dimension-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--gradient-brand);
  transition: width 0.6s ease;
}

/* ============ 改进建议 ============ */
.suggestions-section {
  margin-top: 16rpx;
}

.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border-left: 6rpx solid var(--brand);
  background: #f8fafd;
  border-radius: 0 12rpx 12rpx 0;
  line-height: 1.7;
}

/* ============ 简历内容摘要 ============ */
.content-section {
  margin-bottom: 32rpx;
}

.content-section:last-child {
  margin-bottom: 0;
}

.content-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.content-value {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 技能标签 */
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.skill-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  background: var(--brand-bg);
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 经历条目 */
.entry-item {
  padding: 20rpx 24rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #fafbfc;
}

.entry-item:last-child {
  margin-bottom: 0;
}

.entry-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.entry-role {
  font-size: 26rpx;
  color: var(--text-hint);
  font-weight: 400;
}

.entry-duration,
.entry-stack {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.entry-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ============ 操作区域 ============ */
.action-card {
  margin-bottom: 24rpx;
}

.action-block {
  margin-bottom: 8rpx;
}

.action-tip {
  display: block;
  font-size: 26rpx;
  color: var(--text-hint);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.btn-action-primary {
  width: 100%;
  height: 92rpx;
  background: var(--gradient-brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 46rpx;
  border: none;
  box-shadow: var(--shadow-brand);
}

.btn-action-primary::after {
  border: none;
}

.btn-action-primary[disabled] {
  background: #e8ecf2;
  color: var(--text-hint);
  box-shadow: none;
}

.action-hint {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 16rpx;
  line-height: 1.5;
  text-align: center;
}

.btn-action-danger {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: 2rpx solid rgba(255, 77, 79, 0.3);
}

.btn-action-danger::after {
  border: none;
}

.btn-action-danger:active {
  background: #fff1f0;
}
