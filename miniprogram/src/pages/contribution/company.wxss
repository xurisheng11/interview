/* 公司面试题库页 */

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.page-sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: var(--shadow-card);
}

.input-placeholder {
  color: #b0b7c3;
}

.search-btn {
  width: 160rpx !important;
  margin: 0;
  background: var(--gradient-brand) !important;
  color: #fff !important;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 0;
  line-height: 2.6;
}

.contribute-link {
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* 降级提示 */
.fallback-tip {
  display: flex;
  gap: 24rpx;
  background: #fffbe6;
  border: 2rpx solid #ffe58f;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.fallback-icon {
  font-size: 44rpx;
}

.fallback-title {
  font-weight: 600;
  color: #333;
  font-size: 26rpx;
}

.fallback-similar {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #555;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.similar-tag {
  background: #fff;
  border: 2rpx solid #ffd666;
  color: #d48806;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.fallback-action {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 500;
}

/* 搜索提示 */
.search-tip {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  background: #f5f7fa;
  border-radius: 10rpx;
}

.tip-strong {
  color: var(--brand);
  font-weight: 600;
}

/* tabs */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 18rpx 0;
  border-radius: 12rpx;
}

.tab.active {
  background: var(--gradient-brand);
  color: #fff;
  font-weight: 600;
}

.tab-badge {
  font-size: 22rpx;
  opacity: 0.9;
}

.tab-badge.warning {
  color: inherit;
}

/* 积分条 */
.credits-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #555;
}

.credit-num {
  color: var(--brand);
  font-weight: 700;
  font-size: 28rpx;
}

.credits-cost {
  color: #999;
  font-size: 22rpx;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  border-left: 8rpx solid transparent;
}

.question-card.verified {
  border-left-color: #52c41a;
  background: linear-gradient(90deg, #f6ffed 0%, #fff 12%);
}

.question-card.pending {
  border-left-color: #ffd666;
  background: linear-gradient(90deg, #fffbe6 0%, #fff 12%);
}

.q-company {
  font-weight: 700;
  font-size: 26rpx;
  color: var(--brand);
  margin-bottom: 12rpx;
}

.q-content {
  font-size: 28rpx;
  color: #222;
  line-height: 1.7;
  margin-bottom: 14rpx;
}

.q-meta {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.mini-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

.mini-tag.diff-success { background: #f6ffed; color: #52c41a; }
.mini-tag.diff-warning { background: #fff7e6; color: #d48806; }
.mini-tag.diff-danger { background: #fff1f0; color: #ff4d4f; }

.q-year {
  font-size: 22rpx;
  color: #999;
}

.q-stats {
  display: flex;
  gap: 28rpx;
  font-size: 22rpx;
  color: #888;
}

/* 投票 */
.vote-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
  border-top: 2rpx solid #f5f5f5;
  padding-top: 18rpx;
  margin-top: 16rpx;
}

.vote-btn {
  margin: 0;
  font-size: 24rpx;
  padding: 0 28rpx;
  line-height: 2.2;
  border-radius: 28rpx;
  background: #f5f5f5;
  color: #555;
}

.vote-btn.helpful.voted {
  background: #f6ffed;
  color: #52c41a;
}

.vote-btn.useless.voted {
  background: #fff1f0;
  color: #ff4d4f;
}

.vote-btn[disabled] {
  opacity: 0.7;
}

.report-btn {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
  padding: 10rpx 16rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 60rpx;
  background: #fafbfd;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 88rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
  margin: 20rpx 0 10rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.empty-state .btn-primary {
  width: 60%;
}

/* 举报弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.report-popup {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 28rpx;
}

.report-question {
  font-size: 24rpx;
  color: #555;
  background: #f5f7fa;
  padding: 20rpx;
  border-radius: 12rpx;
  line-height: 1.6;
}

.report-textarea {
  width: 100%;
  min-height: 140rpx;
  background: var(--bg-input, #f5f7fa);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
  margin-top: 24rpx;
}

.report-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.report-btns .btn-primary,
.btn-cancel {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: 16rpx;
}

.btn-cancel {
  background: #f5f7fa;
  color: #666;
}
