<!--pages/community/index.wxml-->
<view class="container">
  <!-- 顶部分类与排序 -->
  <view class="filter-section anim-fade-in">
    <scroll-view scroll-x class="category-scroll">
      <view class="category-tabs">
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="tab-item {{activeCategory === item.value ? 'active' : ''}}"
          bindtap="selectCategory"
          data-value="{{item.value}}"
        >
          <text>{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="sort-row">
      <view class="sort-group">
        <view
          class="sort-btn {{sortBy === 'hot' ? 'active' : ''}}"
          bindtap="switchSort"
          data-sort="hot"
        >🔥 热度</view>
        <view
          class="sort-btn {{sortBy === 'new' ? 'active' : ''}}"
          bindtap="switchSort"
          data-sort="new"
        >🕐 最新</view>
      </view>
      <view class="ai-btn btn-press" bindtap="openAIDialog">
        <text class="ai-btn-icon">🤖</text>
        <text>AI 知识获取</text>
      </view>
    </view>
  </view>

  <!-- 文章列表 -->
  <view class="article-list" wx:if="{{articles.length > 0}}">
    <view
      wx:for="{{articles}}"
      wx:key="_id"
      class="article-card anim-fade-in"
      hover-class="card-pressed"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <view class="article-title">{{item.title}}</view>

      <view class="article-tags">
        <text
          wx:for="{{item.tags}}"
          wx:for-item="tag"
          wx:key="*this"
          class="tag tag-default"
          wx:if="{{index < 3}}"
        >{{tag}}</text>
        <text wx:if="{{item.isAiGenerated}}" class="tag tag-warning">AI生成</text>
      </view>

      <view class="article-stats">
        <view class="stat-item">
          <text class="stat-icon">👍</text>
          <text>{{item.likeCount || 0}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">⭐</text>
          <text>{{item.collectCount || 0}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">💬</text>
          <text>{{item.commentCount || 0}}</text>
        </view>
        <view class="stat-time">{{item._time}}</view>
      </view>
    </view>
  </view>

  <!-- 加载更多提示 -->
  <view class="load-more" wx:if="{{articles.length > 0}}">
    <view wx:if="{{loading}}" class="loading-tip">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
    <view wx:elif="{{noMore}}" class="no-more-tip">
      <text>— 已加载全部 —</text>
    </view>
  </view>

  <!-- 首次加载 loading -->
  <view class="loading" wx:if="{{loading && articles.length === 0}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && articles.length === 0}}">
    <view class="empty-icon-wrap">
      <view class="empty-cube icon-cube">📄</view>
    </view>
    <text class="empty-text">正在为你准备内容</text>
    <text class="empty-desc">稍后下拉刷新试试</text>
  </view>

  <!-- AI 生成文章弹窗 -->
  <view class="dialog-mask" wx:if="{{showAIDialog}}" bindtap="closeAIDialog" catchtouchmove="preventScroll">
    <view class="dialog-box" catchtap="preventScroll">
      <view class="dialog-header">
        <text class="dialog-title">🤖 AI 知识获取</text>
        <view class="dialog-close" bindtap="closeAIDialog">✕</view>
      </view>

      <view class="dialog-body">
        <view class="form-group">
          <text class="form-label">知识点</text>
          <input
            class="form-input"
            placeholder="请输入想了解的知识点，如：Redis持久化机制"
            placeholder-class="form-placeholder"
            value="{{aiForm.topic}}"
            bindinput="onTopicInput"
            maxlength="100"
          />
        </view>

        <view class="form-group">
          <text class="form-label">岗位方向</text>
          <picker
            mode="selector"
            range="{{categories}}"
            range-key="label"
            bindchange="onJobCategoryChange"
          >
            <view class="form-picker {{aiForm.jobCategory ? '' : 'placeholder'}}">
              <text>{{aiForm.jobCategoryLabel ? aiForm.jobCategoryLabel : '请选择岗位方向'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="dialog-footer">
        <view class="btn-cancel" bindtap="closeAIDialog">取消</view>
        <view
          class="btn-confirm {{(!aiForm.topic || !aiForm.jobCategory || aiGenerating) ? 'disabled' : ''}}"
          bindtap="{{(!aiForm.topic || !aiForm.jobCategory || aiGenerating) ? '' : 'generateArticle'}}"
        >
          <text wx:if="{{aiGenerating}}">生成中...</text>
          <text wx:else>生成文章</text>
        </view>
      </view>
    </view>
  </view>
</view>
