<view class="container">
  <!-- 常见问题 -->
  <view class="section anim-fade-in">
    <text class="section-title">常见问题</text>

    <view class="faq-list">
      <view
        wx:for="{{faqList}}"
        wx:key="id"
        class="faq-item {{item.expanded ? 'expanded' : ''}}"
        hover-class="item-pressed"
        bindtap="toggleFaq"
        data-id="{{item.id}}"
      >
        <view class="faq-header">
          <view class="faq-q-badge">
            <text>Q</text>
          </view>
          <text class="faq-q">{{item.question}}</text>
          <text class="faq-arrow {{item.expanded ? 'open' : ''}}">›</text>
        </view>
        <view class="faq-answer" wx:if="{{item.expanded}}">
          <text>{{item.answer}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 教程 -->
  <view class="section anim-fade-in">
    <text class="section-title">使用教程</text>

    <view class="tutorial-list">
      <view class="tutorial-item" hover-class="item-pressed" bindtap="viewTutorial" data-type="new">
        <view class="tutorial-icon icon-cube t-blue">始</view>
        <view class="tutorial-content">
          <text class="tutorial-title">如何开始面试</text>
          <text class="tutorial-desc">快速上手面试练习</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="tutorial-item" hover-class="item-pressed" bindtap="viewTutorial" data-type="record">
        <view class="tutorial-icon icon-cube t-orange">录</view>
        <view class="tutorial-content">
          <text class="tutorial-title">如何使用录音功能</text>
          <text class="tutorial-desc">录制语音回答</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="tutorial-item" hover-class="item-pressed" bindtap="viewTutorial" data-type="report">
        <view class="tutorial-icon icon-cube t-green">报</view>
        <view class="tutorial-content">
          <text class="tutorial-title">如何查看报告</text>
          <text class="tutorial-desc">解读面试评估报告</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 反馈 -->
  <view class="section anim-fade-in">
    <text class="section-title">意见反馈</text>

    <view class="feedback-form">
      <textarea
        class="feedback-input"
        placeholder="请输入您的宝贵意见..."
        placeholder-class="feedback-placeholder"
        value="{{feedbackContent}}"
        bindinput="onFeedbackInput"
        maxlength="500"
      ></textarea>
      <view class="feedback-footer">
        <text class="char-count">{{feedbackContent.length}}/500</text>
      </view>

      <button class="btn-submit" bindtap="submitFeedback" loading="{{submitting}}">
        提交反馈
      </button>
    </view>
  </view>

  <!-- 联系客服 -->
  <view class="section anim-fade-in">
    <text class="section-title">联系客服</text>

    <view class="contact-list">
      <view class="contact-item" hover-class="item-pressed" bindtap="contactWechat">
        <view class="contact-left">
          <view class="contact-icon icon-cube t-green">微</view>
          <text class="contact-label">微信号</text>
        </view>
        <text class="contact-value">xurixuxuxu</text>
      </view>

      <view class="contact-item" hover-class="item-pressed" bindtap="contactEmail">
        <view class="contact-left">
          <view class="contact-icon icon-cube t-blue">邮</view>
          <text class="contact-label">邮箱地址</text>
        </view>
        <text class="contact-value">xurisheng1133@163.com</text>
      </view>
    </view>
  </view>
</view>
