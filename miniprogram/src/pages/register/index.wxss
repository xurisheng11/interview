/* 注册页面样式 */
.container {
  min-height: 100vh;
  background:
    radial-gradient(1000rpx 500rpx at -10% -10%, rgba(22, 119, 255, 0.08), transparent),
    linear-gradient(180deg, #eef5ff 0%, #f4f6fa 30%);
  padding: 32rpx;
}

/* 表单卡片 */
.form {
  position: relative;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 36rpx 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(20, 45, 90, 0.08);
  overflow: hidden;
}

/* 卡片顶部品牌装饰条 */
.form::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #52a9ff, #1677ff, #0958d9);
}

.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  font-weight: 500;
  margin-bottom: 14rpx;
}

.input-field {
  width: 100%;
  height: 92rpx;
  padding: 0 28rpx;
  background: #f8fafd;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  font-size: 30rpx;
  color: var(--text-main);
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.input-field::placeholder {
  color: #b8c0cc;
}

/* 协议 */
.agreement {
  margin-bottom: 36rpx;
  padding: 0 12rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-left: 8rpx;
}

.agreement-link {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  margin-left: 4rpx;
}

/* 注册按钮 */
.btn-register {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 46rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);
}

.btn-register::after {
  border: none;
}

.btn-register:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-register[disabled] {
  background: #dde3ec;
  color: #9aa3af;
  box-shadow: none;
}

/* 登录链接 */
.login-link {
  text-align: center;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.link {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 600;
  margin-left: 8rpx;
}
