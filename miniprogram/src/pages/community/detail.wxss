/* pages/community/detail.wxss */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 24rpx 48rpx;
}

/* ============ 文章卡片 ============ */
.article-card {
  margin-bottom: 24rpx;
}

.article-header {
  margin-bottom: 8rpx;
}

.article-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: block;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-time {
  font-size: 24rpx;
  color: #b8c0cc;
}

/* ============ 文章正文 ============ */
.article-body {
  padding: 8rpx 0;
}

.rich-content {
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 1.8;
  word-break: break-all;
}

/* ============ 操作按钮 ============ */
.action-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: #f2f4f7;
  color: var(--text-sub);
  transition: all 0.2s ease;
}

.action-icon {
  font-size: 28rpx;
}

.like-btn.active {
  background: var(--brand-bg);
  color: var(--brand);
}

.collect-btn.active {
  background: #fff7e0;
  color: #ef9400;
}

.back-btn {
  margin-left: auto;
  color: var(--text-hint);
}

/* ============ 评论�?============ */
.comment-section {
  margin-bottom: 24rpx;
}

.comment-input-wrap {
  margin-bottom: 12rpx;
}

.comment-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e8ecf2;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  box-sizing: border-box;
  background: #fafbfc;
}

.comment-placeholder {
  color: #b8c0cc;
}

.comment-submit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.word-count {
  font-size: 22rpx;
  color: var(--text-hint);
}

.submit-btn {
  padding: 14rpx 36rpx;
  background: var(--gradient-brand);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}

.submit-btn.disabled {
  background: #e8ecf2;
  color: #b8c0cc;
  box-shadow: none;
}

/* ============ 评论列表 ============ */
.comments-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-hint);
}

.empty-comments {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--text-hint);
}

.comment-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-author {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.comment-content {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #b8c0cc;
}

/* ============ Loading ============ */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 16rpx;
  color: var(--text-hint);
  font-size: 26rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e8ecf2;
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ============ 空状�?============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon-wrap {
  margin-bottom: 32rpx;
}

.empty-cube {
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ffe0e0 0%, #ffbdbd 100%);
  font-size: 56rpx;
  position: relative;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 32rpx;
}

.empty-action {
  padding: 18rpx 48rpx;
  background: var(--gradient-brand);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}

/* ============ 按压反馈 ============ */
.btn-press {
  opacity: 0.85;
  transform: scale(0.97);
}
