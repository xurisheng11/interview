# ===== 域名与证书 =====
# 你的 API 域名（小程序后台 request 合法域名将使用它）
DOMAIN=api.example.com
# 证书续期通知邮箱
CERTBOT_EMAIL=you@example.com

# ===== 安全项（全部改成强随机值，别用默认值上线）=====
JWT_SECRET=please-change-me-to-a-long-random-string
MYSQL_ROOT_PASSWORD=please-change-me
MYSQL_USER=interview
MYSQL_PASSWORD=please-change-me
REDIS_PASSWORD=please-change-me

# ===== 业务密钥 =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 微信小程序（登录必需）
WX_APP_ID=wx437f73b0e2347eb7
WX_SECRET=your-wx-secret

# ===== 可选 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
JWT_EXPIRE_DAYS=7
AI_DAILY_LIMIT=10
INTERVIEW_QUESTION_COUNT=10
MYSQL_SYNC_HOUR=2
