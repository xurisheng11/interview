/* 设置页面样式 */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 8rpx 24rpx 48rpx;
}

.section {
  margin-bottom: 28rpx;
}

/* 分组标题 */
.section-title {
  display: flex;
  align-items: center;
  padding: 24rpx 12rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #52a9ff, #0958d9);
  margin-right: 14rpx;
}

/* 分组卡片 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

/* 分组卡片化：首尾圆角 + 阴影 */
.setting-item:first-of-type {
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.05);
}

.setting-item:last-of-type {
  border-radius: 0 0 24rpx 24rpx;
  border-bottom: none;
  box-shadow: 0 12rpx 24rpx rgba(20, 45, 90, 0.05);
}

.setting-item:first-of-type:last-of-type {
  border-radius: 24rpx;
}

.item-pressed {
  background: #f4f7fc;
}

.item-left {
  display: flex;
  align-items: center;
}

/* 渐变图标 */
.item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  margin-right: 24rpx;
  position: relative;
}

.item-icon::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  transform: rotate(-20deg);
}

.c-blue {
  background: linear-gradient(135deg, #52a9ff 0%, #0958d9 100%);
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.22);
}

.c-green {
  background: linear-gradient(135deg, #73d13d 0%, #389e0d 100%);
  box-shadow: 0 6rpx 16rpx rgba(82, 196, 26, 0.22);
}

.c-orange {
  background: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  box-shadow: 0 6rpx 16rpx rgba(250, 173, 20, 0.22);
}

.c-purple {
  background: linear-gradient(135deg, #b37feb 0%, #531dab 100%);
  box-shadow: 0 6rpx 16rpx rgba(114, 46, 209, 0.22);
}

.c-cyan {
  background: linear-gradient(135deg, #5cdbd3 0%, #08979c 100%);
  box-shadow: 0 6rpx 16rpx rgba(19, 194, 194, 0.22);
}

.c-pink {
  background: linear-gradient(135deg, #ff85c0 0%, #c41d7f 100%);
  box-shadow: 0 6rpx 16rpx rgba(235, 47, 150, 0.22);
}

.item-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.item-right {
  display: flex;
  align-items: center;
}

.cache-size,
.version {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-right: 12rpx;
}

.arrow {
  font-size: 36rpx;
  color: #c5ccd6;
  line-height: 1;
}

/* 退出登录 */
.logout-section {
  padding: 32rpx 0;
}

.btn-logout {
  width: 100%;
  height: 92rpx;
  background: #fff;
  color: var(--danger);
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 46rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: #fff1f0;
  transform: scale(0.98);
}
