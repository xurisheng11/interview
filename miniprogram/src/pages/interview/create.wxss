/* 面试配置页样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 进度条 */
.progress-bar {
  display: flex;
  align-items: center;
  padding: 32rpx 60rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.4;
}

.progress-step.active {
  opacity: 1;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #e0e0e0;
  border-radius: 50%;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.progress-step.active .step-num {
  background: #1890ff;
}

.progress-step .step-text {
  font-size: 22rpx;
  color: #999;
}

.progress-step.active .step-text {
  color: #1890ff;
}

.progress-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 20rpx;
  margin-bottom: 28rpx;
}

.progress-line.active {
  background: #1890ff;
}

/* 步骤内容 */
.step-content {
  display: none;
  padding: 0 24rpx;
}

.step-content.show {
  display: block;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

/* 输入框 */
.input-wrapper {
  margin-top: 16rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: #bbb;
}

/* 岗位选择 */
.category-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.category-tabs::-webkit-scrollbar {
  display: none;
}

.category-tab {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.category-tab.active {
  background: #1677ff;
  color: #fff;
}

.category-icon {
  font-size: 28rpx;
}

.category-label {
  font-weight: 500;
}

.job-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.job-item {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.job-item:active {
  transform: scale(0.96);
}

.job-item.active {
  background: #e6f7ff;
  border-color: #1677ff;
}

.job-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.job-item.active .job-name {
  color: #1677ff;
}

/* 自定义岗位 */
.custom-job-wrap {
  margin-top: 20rpx;
}

.custom-job-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.custom-job-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.btn-custom-job {
  height: 72rpx;
  padding: 0 32rpx;
  background: #1677ff;
  color: #fff;
  font-size: 26rpx;
  border-radius: 36rpx;
  border: none;
  line-height: 72rpx;
}

.btn-custom-job::after {
  border: none;
}

.custom-job-tip {
  display: block;
  font-size: 24rpx;
  color: #1677ff;
  margin-top: 12rpx;
  padding-left: 12rpx;
}

/* 轮次选择 */
.round-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.round-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.round-item:active {
  transform: scale(0.98);
}

.round-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.round-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.round-item.active .round-name {
  color: #1890ff;
}

.round-desc {
  font-size: 22rpx;
  color: #999;
}

/* 难度选择 */
.difficulty-row {
  display: flex;
  gap: 20rpx;
}

.difficulty-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.difficulty-item.active {
  border-color: #1890ff;
}

.difficulty-item.easy.active {
  border-color: #52c41a;
  background: #f6ffed;
}

.difficulty-item.medium.active {
  border-color: #faad14;
  background: #fffbe6;
}

.difficulty-item.hard.active {
  border-color: #ff4d4f;
  background: #fff1f0;
}

.diff-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.diff-desc {
  font-size: 20rpx;
  color: #999;
}

/* 面试形式 */
.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.type-item:active {
  transform: scale(0.98);
}

.type-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.type-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: #ccc;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.type-item.active .type-icon {
  background: #1890ff;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.type-desc {
  font-size: 22rpx;
  color: #999;
}

/* 重点领域 */
.focus-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.focus-item {
  padding: 12rpx 24rpx;
  background: #f8f8f8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.focus-item:active {
  transform: scale(0.95);
}

.focus-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
  color: #1890ff;
}

/* 模式选择 */
.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.mode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.mode-item:active {
  transform: scale(0.98);
}

.mode-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.mode-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.mode-item.active .mode-name {
  color: #1890ff;
}

.mode-desc {
  font-size: 22rpx;
  color: #999;
}

/* 时间选择 */
.time-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.time-item {
  padding: 16rpx 32rpx;
  background: #f8f8f8;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.time-item:active {
  transform: scale(0.95);
}

.time-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
  color: #1890ff;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.step-btns {
  flex: none;
}

.btn-prev {
  width: 200rpx;
  height: 88rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-next {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.btn-next.btn-start {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.3);
}

.btn-next[disabled] {
  background: #d9d9d9;
  box-shadow: none;
}
