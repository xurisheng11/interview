<view class="container">
  <!-- 视频面试：右上角悬浮摄像头预览（可最小化，不阻断面试） -->
  <block wx:if="{{isCamera}}">
    <view class="camera-float" wx:if="{{!cameraMinimized && !cameraBlocked}}" style="top: {{camTop}}px; left: {{camLeft}}px;">
      <camera
        class="camera-view"
        mode="mirrored"
        device-position="front"
        flash="none"
        binderror="onCameraError"
        bindinitdone="onCameraInitDone"
      ></camera>
      <!-- 拖拽手柄：按住可把画面移到不挡题的位置 -->
      <view class="camera-drag" catchtouchstart="onCamDragStart" catchtouchmove="onCamDragMove" catchtouchend="onCamDragEnd">≡ 拖动</view>
      <view class="camera-badge">
        <view class="camera-rec-dot"></view>
        <text>视频面试中</text>
      </view>
      <view class="camera-min" catchtap="toggleCameraMin">✕</view>
    </view>
    <view class="camera-restore" wx:elif="{{!cameraBlocked}}" catchtap="toggleCameraMin" style="top: {{camTop}}px; left: {{camLeft}}px;">
      <text>🎥</text>
      <text class="camera-restore-tag" wx:if="{{cameraPausedForMic}}">画面已暂停</text>
    </view>
    <view class="camera-warn" wx:if="{{cameraBlocked}}">摄像头不可用，已降级为语音答题</view>
  </block>

  <!-- 顶部进度条 -->
  <view class="progress-bar">
    <view class="progress-info">
      <text class="progress-text">第 {{currentIndex + 1}} / {{totalCount}} 题</text>
      <text class="timer-text">⏱ {{remainingTimeText}}</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
  </view>

  <!-- 问题卡片 -->
  <view class="question-card" wx:if="{{currentQuestion}}">
    <view class="question-header">
      <view class="question-type-tag">
        <text>{{currentTypeName}}</text>
      </view>
      <view class="question-difficulty {{currentQuestion.difficulty}}">
        <text>{{currentDifficultyName}}</text>
      </view>
    </view>
    
    <view class="question-content">
      <text class="question-text">{{currentQuestion.content}}</text>
    </view>

    <view class="question-hint" wx:if="{{currentQuestion.hint}}">
      <text class="hint-icon">💡</text>
      <text class="hint-text">{{currentQuestion.hint}}</text>
    </view>
  </view>

  <!-- 答案输入区 -->
  <view class="answer-section">
    <view class="answer-header">
      <text class="answer-label">{{isCamera ? '你的回答（说话自动转文字）' : (isVoice ? '你的回答（语音自动转文字）' : '你的回答')}}</text>
      <text class="answer-tips">{{isCamera ? '直接说话即可，文字自动追加，可编辑、计入评分' : (isVoice ? '录音停止后自动转写追加，可编辑、计入评分' : '建议条理清晰、要点完整')}}</text>
    </view>
    
    <textarea 
      class="answer-input {{isRecording ? 'recording' : ''}}"
      placeholder="{{isCamera ? '说话后自动填入，也可手动输入' : (isVoice ? '录音结束后自动填入，也可手动输入' : '请输入你的回答...')}}"
      value="{{answer}}"
      bindinput="onAnswerInput"
      maxlength="{{maxLength}}"
      disabled="{{!currentQuestion}}"
    ></textarea>
    
    <view class="answer-footer">
      <text class="char-count">{{answer.length}} / {{maxLength}}</text>
    </view>
  </view>

  <!-- 视频面试：无录音按钮，全自动识别，仅一条状态提示条（停止时点一下可恢复） -->
  <view class="auto-bar" wx:if="{{isCamera}}" bindtap="resumeAutoRecord">
    <view class="auto-dot" wx:if="{{isRecording || isTranscribing}}"></view>
    <text class="auto-bar-text">{{isTranscribing ? '正在转写，文字会自动追加到回答…' : (isRecording ? '自动识别中：直接说话即可，无需任何操作' : '自动识别未运行，点此恢复；也可手动输入作答')}}</text>
  </view>

  <!-- 录音区域（语音模式手动录音；视频模式已改为上方自动识别条） -->
  <view class="record-section" wx:if="{{isVoice && !isCamera}}">
    <view class="record-row">
      <button
        class="btn-record {{isRecording ? 'stop' : 'start'}}"
        bindtap="toggleRecord"
        disabled="{{!currentQuestion || isTranscribing}}"
      >
        <text class="record-icon">{{isRecording ? '⏹' : '🎤'}}</text>
      </button>

      <view class="record-info">
        <view class="record-status-line">
          <text class="record-dot" wx:if="{{isRecording || isTranscribing}}"></text>
          <text class="record-status {{isRecording || isTranscribing ? 'on' : ''}}">{{isTranscribing ? '正在转写，请稍候...' : (isRecording ? (autoRecord ? '自动识别中，直接说话即可' : (speechToText ? '正在听写...' : '正在录音...')) : (audioPath ? '录音完成，转写文字已追加到回答' : '点麦克风说话答题，停止后自动转文字'))}}</text>
          <text class="record-time" wx:if="{{isRecording}}">{{recordTimeText}} / 01:00</text>
        </view>
        <text class="record-sub-hint">{{isTranscribing ? '转写约需几秒，请稍候勿离开' : (autoRecord ? '视频面试已开自动识别：说话即转文字，超 60 秒自动分段衔接；点麦克风可暂停' : '单次上限 60 秒，可多段录音逐段转写拼接')}}</text>
      </view>

      <button
        class="btn-play"
        bindtap="playAudio"
        wx:if="{{audioPath && !isRecording && !isTranscribing}}"
      >
        <text>{{isPlaying ? '⏸' : '▶'}}</text>
      </button>
    </view>

    <view class="record-live" wx:if="{{isRecording && speechToText}}">
      <text>{{liveRecognizeText || '正在聆听，请开始说话...'}}</text>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="bottom-bar">
    <button 
      class="btn-prev {{currentIndex === 0 ? 'disabled' : ''}}"
      bindtap="prevQuestion"
      disabled="{{currentIndex === 0}}"
    >
      <text>上一题</text>
    </button>

    <view class="btn-center">
      <button 
        class="btn-skip"
        bindtap="skipQuestion"
      >
        <text>跳过</text>
      </button>
    </view>

    <button 
      class="btn-next"
      bindtap="nextQuestion"
      loading="{{submitting}}"
    >
      <text>{{currentIndex === totalCount - 1 ? '提交' : '下一题'}}</text>
    </button>
  </view>

  <!-- 完成弹窗 -->
  <view class="modal-overlay" wx:if="{{showCompleteModal}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-icon">✅</view>
      <text class="modal-title">面试已完成</text>
      <text class="modal-desc">正在生成面试报告...</text>
      <view class="modal-progress">
        <view class="modal-progress-bar"></view>
      </view>
    </view>
  </view>
</view>
