/* 分享报告页（好友视角，只读美化版） */
.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #9aa3af;
  font-size: 28rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 200rpx 60rpx 0;
}

.empty-icon { font-size: 88rpx; }

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
}

/* ============ 渐变头部 ============ */
.hero {
  background: linear-gradient(160deg, #1677ff 0%, #0e5fd8 55%, #0a4bb3 100%);
  padding: 48rpx 40rpx 120rpx;
  color: #fff;
}

.hero-brand {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 20rpx;
}

.hero-company {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-job {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.hero-tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

/* 得分玻璃卡 */
.score-card {
  display: flex;
  align-items: center;
  gap: 36rpx;
  margin-top: 40rpx;
  padding: 32rpx 36rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(10rpx);
}

.score-main {
  display: flex;
  align-items: baseline;
}

.score-num {
  font-size: 108rpx;
  font-weight: 800;
  line-height: 1;
}

.score-unit {
  font-size: 28rpx;
  margin-left: 8rpx;
  opacity: 0.85;
}

.score-side {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.grade-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.grade-badge {
  font-size: 26rpx;
  font-weight: 700;
  padding: 8rpx 26rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #1677ff;
}

.pass-chip {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
}

.pass-chip.pass { background: rgba(46, 204, 113, 0.9); }
.pass-chip.pending { background: rgba(243, 156, 18, 0.9); }
.pass-chip.fail { background: rgba(231, 76, 60, 0.9); }

.score-count {
  font-size: 24rpx;
  opacity: 0.85;
}

/* ============ 内容区（上移叠在渐变上） ============ */
.body {
  margin-top: -72rpx;
  padding: 0 24rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 45, 90, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 24rpx;
}

/* 表达指标 */
.metric-grid {
  display: flex;
  gap: 16rpx;
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: #f6f9fe;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1677ff;
}

.metric-label {
  font-size: 22rpx;
  color: #9aa3af;
}

.face-note {
  display: block;
  font-size: 22rpx;
  color: #98a3b3;
  margin-top: 16rpx;
}

.summary-text {
  margin-top: 20rpx;
  background: #f8fafd;
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

/* 模块得分条 */
.module-item { margin-bottom: 22rpx; }
.module-item:last-child { margin-bottom: 0; }

.module-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.module-name {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.module-count {
  font-size: 20rpx;
  color: #9aa3af;
  margin-left: 12rpx;
}

.module-score {
  font-size: 28rpx;
  font-weight: 700;
  color: #1677ff;
}

.module-score.excellent { color: #16a34a; }
.module-score.pass { color: #ef9400; }
.module-score.warning { color: #dc2626; }

.module-level {
  font-size: 20rpx;
  font-weight: 400;
  color: #9aa3af;
  margin-left: 10rpx;
}

.module-bar {
  height: 14rpx;
  background: #f0f3f7;
  border-radius: 7rpx;
  overflow: hidden;
}

.module-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  background: linear-gradient(90deg, #1677ff, #6bb6ff);
}

.module-bar-fill.excellent { background: linear-gradient(90deg, #16a34a, #4ade80); }
.module-bar-fill.pass { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.module-bar-fill.warning { background: linear-gradient(90deg, #ef4444, #f87171); }

/* AI 评价 */
.ai-sub {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  margin: 20rpx 0 12rpx;
}

.ai-sub:first-of-type { margin-top: 0; }
.good-t { color: #16a34a; }
.bad-t { color: #d97706; }

.ai-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.ai-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 14rpx;
}

.good-d { background: #16a34a; }
.bad-d { background: #ef9400; }

.ai-line-text {
  flex: 1;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.ai-weak { margin-bottom: 18rpx; }

.weak-sug {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  background: #f8fafd;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin: 6rpx 0 0 24rpx;
  line-height: 1.6;
}

/* 转化引导 */
.promo {
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.promo-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.promo-sub {
  font-size: 24rpx;
  color: #9aa3af;
  margin-top: 8rpx;
}

.cta {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-top: 28rpx;
  background: linear-gradient(135deg, #1677ff, #4593fc);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 12rpx 30rpx rgba(22, 119, 255, 0.3);
}

.cta::after { border: none; }

.cta.ghost {
  background: #fff;
  color: #1677ff;
  border: 2rpx solid rgba(22, 119, 255, 0.4);
  box-shadow: none;
  width: 480rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b0b8c4;
  margin-top: 28rpx;
}
