/* 面试列表页面样式 */
.container {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* ============ 悬浮开始按钮 ============ */
.fab-container {
  position: fixed;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  right: 40rpx;
  z-index: 100;
}

.fab {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  position: relative;
  transition: all 0.15s ease;
}

/* FAB 顶部光泽 */
.fab::after {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 26rpx;
  width: 36rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(-20deg);
}

.fab-pressed {
  transform: scale(0.92);
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.35);
}

.fab-icon {
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

/* ============ 面试卡片 ============ */
.interview-card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 32rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  overflow: hidden;
  transition: all 0.15s ease;
}

/* 左侧品牌色条（随状态变色） */
.interview-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #52a9ff, #0958d9);
}

.card-pressed {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(20, 45, 90, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.company-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.company {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.position {
  font-size: 26rpx;
  color: var(--text-sub);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: currentColor;
}

.status-badge.pending {
  background: #fff7e0;
  color: #ef9400;
}

.status-badge.in_progress {
  background: var(--brand-bg);
  color: var(--brand);
}

.status-badge.completed {
  background: #f0fbe4;
  color: var(--success);
}

.status-badge.paused {
  background: #f2f4f7;
  color: var(--text-hint);
}

/* 状态对应左侧色条 */
.interview-card.completed::before {
  background: linear-gradient(180deg, #73d13d, #389e0d);
}

.interview-card.pending::before {
  background: linear-gradient(180deg, #ffc53d, #d48806);
}

.interview-card.paused::before {
  background: linear-gradient(180deg, #c5ccd6, #9aa3af);
}

.card-body {
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2f4f7;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}

.label {
  font-size: 26rpx;
  color: var(--text-hint);
}

.value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
}

.score-section {
  display: flex;
  align-items: baseline;
}

.score-label {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-right: 12rpx;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.score-value.excellent {
  color: var(--success);
}

.score-value.good {
  color: var(--brand);
}

.score-value.warning {
  color: #ef9400;
}

.score-value.score-none {
  color: #c5ccd6;
  font-size: 44rpx;
}

.action-hint {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
}

/* ============ 空状态 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-cube {
  width: 160rpx;
  height: 160rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #d6e6ff 0%, #b3d1ff 100%);
  color: var(--brand);
  font-size: 64rpx;
  font-weight: 700;
  margin-bottom: 36rpx;
  position: relative;
}

.empty-cube::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 26rpx;
  width: 44rpx;
  height: 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  transform: rotate(-20deg);
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-bottom: 40rpx;
}

.btn-start {
  width: 480rpx;
  height: 92rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 46rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);
}

.btn-start::after {
  border: none;
}

.btn-start:active {
  transform: scale(0.97);
  opacity: 0.92;
}
