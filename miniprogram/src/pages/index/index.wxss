/* 首页样式 */
.container {
  padding: 24rpx;
}

/* ============ 自定义品牌顶栏 ============ */
.brand-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: -24rpx -24rpx 24rpx;
  padding: 0 32rpx 14rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 4rpx 16rpx rgba(20, 45, 90, 0.05);
}

.brand-nav-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.brand-nav-texts {
  display: flex;
  flex-direction: column;
}

.brand-nav-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.3;
}

.brand-nav-slogan {
  font-size: 20rpx;
  color: var(--text-hint);
}

/* ============ 未登录态（对齐登录页风格：渐变头部 + 浮起面板） ============ */
.login-container {
  min-height: 100vh;
  background:
    radial-gradient(1200rpx 600rpx at 110% -10%, rgba(22, 119, 255, 0.08), transparent),
    linear-gradient(180deg, #eaf3ff 0%, #f4f6fa 40%);
  display: flex;
  flex-direction: column;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 品牌渐变头部 */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  border-radius: 0 0 48rpx 48rpx;
  padding: 96rpx 48rpx 128rpx;
  box-shadow: 0 12rpx 36rpx rgba(22, 119, 255, 0.25);
}

/* hero 专属装饰光斑尺寸（避免影响已登录用户卡） */
.hero .deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -120rpx;
  right: -80rpx;
}

.hero .deco-2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -60rpx;
  left: 60rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-ring {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  padding: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo {
  width: 148rpx;
  height: 148rpx;
  border-radius: 40rpx;
  display: block;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 28rpx;
}

.hero-feature {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
}

.feature-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.8;
}

.feature-text {
  font-size: 24rpx;
  color: #fff;
  letter-spacing: 1rpx;
}

/* 登录面板（浮起） */
.login-body {
  position: relative;
  z-index: 2;
  margin: -84rpx 40rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(20, 45, 90, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-wx-login {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2ad46b 0%, #07c160 50%, #059a4c 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.32);
}

.btn-wx-login::after {
  border: none;
}

.btn-wx-login:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.wx-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
}

.login-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.login-alt {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.alt-divider {
  margin: 0 20rpx;
  color: #d8dee7;
}

/* 底部协议 */
.login-footer {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  padding: 48rpx 40rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.agreement {
  color: var(--text-hint);
}

.link {
  color: var(--brand);
}

/* ============ 用户卡片（品牌渐变） ============ */
.user-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.28);
}

/* 装饰光斑 */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.deco-1 {
  width: 260rpx;
  height: 260rpx;
  top: -110rpx;
  right: -60rpx;
}

.deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -60rpx;
  right: 180rpx;
  background: rgba(255, 255, 255, 0.08);
}

.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

/* 头像白色描边 */
.avatar-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.35);
  margin-right: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: block;
}

.info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.role-tag {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  color: #fff;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.role-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b7ffb7;
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx rgba(183, 255, 183, 0.9);
}

/* ============ 快捷操作 ============ */
.quick-actions {
  display: flex;
  justify-content: space-between;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 12rpx 0;
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.action-pressed {
  background: #f4f7fc;
  transform: scale(0.96);
}

.action-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  box-shadow: inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

/* 顶部光泽 */
.action-icon::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 14rpx;
  width: 36rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
  transform: rotate(-20deg);
}

.bg-blue {
  background: linear-gradient(135deg, #52a9ff 0%, #0958d9 100%);
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-green {
  background: linear-gradient(135deg, #73d13d 0%, #389e0d 100%);
  box-shadow: 0 8rpx 20rpx rgba(82, 196, 26, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-orange {
  background: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  box-shadow: 0 8rpx 20rpx rgba(250, 173, 20, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-purple {
  background: linear-gradient(135deg, #b37feb 0%, #722ed1 100%);
  box-shadow: 0 8rpx 20rpx rgba(114, 46, 209, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-cyan {
  background: linear-gradient(135deg, #5cdbd3 0%, #08979c 100%);
  box-shadow: 0 8rpx 20rpx rgba(19, 194, 194, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-pink {
  background: linear-gradient(135deg, #ff85c0 0%, #c41d7f 100%);
  box-shadow: 0 8rpx 20rpx rgba(235, 47, 150, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-gold {
  background: linear-gradient(135deg, #ffd666 0%, #ad6800 100%);
  box-shadow: 0 8rpx 20rpx rgba(212, 136, 6, 0.28), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.bg-gray {
  background: linear-gradient(135deg, #bfbfbf 0%, #595959 100%);
  box-shadow: 0 8rpx 20rpx rgba(89, 89, 89, 0.24), inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.10);
}

.icon-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
}

/* ============ 功能导航宫格 ============ */
.func-grid {
  display: flex;
  flex-wrap: wrap;
}

.func-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  transition: all 0.15s ease;
}

.func-item .action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  margin-bottom: 12rpx;
}

.func-item .icon-text {
  font-size: 34rpx;
}

.func-item .action-text {
  font-size: 24rpx;
}

/* ============ 统计数据 ============ */
.stats-card {
  padding: 40rpx 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1f6;
}

.stat-value {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
}

.v-blue {
  color: var(--brand);
}

.v-green {
  color: var(--success);
}

.v-orange {
  color: #ef9400;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

/* ============ 最近面试 ============ */
.interview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 16rpx;
  margin: 0 -16rpx;
  border-radius: 16rpx;
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

.interview-item:last-child {
  border-bottom: none;
}

.item-pressed {
  background: #f4f7fc;
}

.interview-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.interview-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.interview-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.interview-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

.interview-mode {
  font-size: 18rpx;
  color: var(--brand);
  background: var(--brand-bg);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.interview-score {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  background: var(--brand-bg);
  border-radius: 16rpx;
  margin-left: 16rpx;
}

.interview-score .score-value {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand);
}

.interview-score .score-label {
  font-size: 24rpx;
  color: var(--brand);
  margin-left: 4rpx;
  opacity: 0.7;
}

/* 分数等级配色 */
.interview-score.s-exc { background: #f0fbe4; }
.interview-score.s-exc .score-value,
.interview-score.s-exc .score-label { color: var(--success); }
.interview-score.s-good { background: var(--brand-bg); }
.interview-score.s-pass { background: #fff7e0; }
.interview-score.s-pass .score-value,
.interview-score.s-pass .score-label { color: #ef9400; }
.interview-score.s-low { background: #fff1f0; }
.interview-score.s-low .score-value,
.interview-score.s-low .score-label { color: var(--danger); }

/* 未完成：状态胶囊 */
.interview-score.s-doing {
  background: #f2f4f7;
  align-items: center;
}

.score-doing {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub);
}
