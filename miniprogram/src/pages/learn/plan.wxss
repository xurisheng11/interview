/* 冲刺计划页样式 */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 24rpx 48rpx;
}

/* ============ 按压反馈 ============ */
.btn-press {
  transform: scale(0.97);
  opacity: 0.92;
}

/* ============ 加载中 ============ */
.loading-wrap {
  padding: 240rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ============ 定制表单 ============ */
.customize-header {
  text-align: center;
  padding: 24rpx 16rpx 32rpx;
}

.customize-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.customize-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.form-item {
  margin-bottom: 36rpx;
}

.form-item:last-of-type {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.required {
  color: var(--danger);
  margin-right: 4rpx;
}

.form-input {
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.input-placeholder {
  color: #b8c0cc;
}

.form-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.6;
  margin-top: 12rpx;
}

/* 冲刺天数选项（2x2） */
.days-grid {
  display: flex;
  flex-wrap: wrap;
}

.days-item {
  width: calc(50% - 8rpx);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 22rpx 16rpx;
  text-align: center;
  transition: all 0.15s ease;
}

.days-item:nth-child(2n) {
  margin-right: 0;
}

.days-item.active {
  background: var(--brand-bg);
  border-color: var(--brand);
}

.days-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
}

.days-item.active .days-num {
  color: var(--brand);
}

.days-desc {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
}

/* 面试日期选择 */
.date-picker-area {
  margin-top: 8rpx;
}

.date-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f5f7fa;
  border: 2rpx dashed rgba(22, 119, 255, 0.4);
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.date-value {
  color: var(--brand);
  font-weight: 600;
}

.date-value.placeholder {
  color: #b8c0cc;
  font-weight: 400;
}

.date-hint {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.6;
  margin-top: 12rpx;
}

/* 通用选项 chips */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #f5f7fa;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  transition: all 0.15s ease;
}

.chip.active {
  background: var(--brand-bg);
  border-color: rgba(22, 119, 255, 0.45);
  color: var(--brand);
  font-weight: 600;
}

/* 生成按钮 */
.generate-btn {
  margin-top: 8rpx;
  width: 100%;
}

/* ============ 计划总览 ============ */
.plan-header {
  background: var(--gradient-brand);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card-lg);
}

.plan-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.plan-summary {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.plan-meta {
  display: flex;
  flex-wrap: wrap;
}

.plan-meta-tag {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin: 0 12rpx 12rpx 0;
}

.plan-stats {
  display: flex;
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.stat-block {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.stat-total {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.7);
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 6rpx;
}

/* ============ 时间进度与操作 ============ */
.progress-row {
  display: flex;
  align-items: center;
}

.progress-track {
  flex: 1;
  height: 16rpx;
  background: #eef1f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--gradient-brand);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand);
  margin-left: 16rpx;
}

.progress-caption {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
}

.plan-actions {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #e8ecf2;
}

.today-phase {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.phase-strong {
  color: var(--brand);
  font-weight: 600;
}

.action-btns {
  display: flex;
}

.action-btns .btn-mini:first-child {
  margin-right: 16rpx;
}

.btn-mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  margin: 0;
  background: #fff;
  border: 2rpx solid #dfe5ee;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.btn-mini::after {
  border: none;
}

.btn-mini-danger {
  color: var(--danger);
  border-color: rgba(255, 77, 79, 0.4);
}

/* ============ 阶段卡片 ============ */
.phase-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  border: 2rpx solid transparent;
}

.phase-card.phase-current {
  border-color: rgba(22, 119, 255, 0.5);
  box-shadow: var(--shadow-card-lg);
}

.phase-card.phase-past {
  opacity: 0.72;
}

.phase-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.phase-badge {
  background: var(--gradient-brand);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.phase-title-wrap {
  flex: 1;
  min-width: 0;
}

.phase-name {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.phase-name .tag {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.phase-range {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.5;
  margin-top: 6rpx;
}

.phase-progress {
  text-align: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.phase-progress-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.2;
}

.phase-progress-unit {
  font-size: 22rpx;
  font-weight: 400;
}

.phase-progress-label {
  font-size: 20rpx;
  color: var(--text-hint);
  margin-top: 2rpx;
}

/* 任务列表 */
.phase-tasks {
  border-top: 1rpx dashed #e8ecf2;
  padding-top: 8rpx;
}

.task-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 8rpx;
  border-radius: 12rpx;
}

.task-pressed {
  background: #f5f8ff;
}

.task-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #c4cbd6;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 4rpx 18rpx 0 0;
  transition: all 0.15s ease;
}

.task-checkbox.checked {
  background: var(--gradient-brand);
  border-color: transparent;
}

.task-check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.task-content {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.6;
}

.task-done .task-content {
  color: var(--text-hint);
  text-decoration: line-through;
}

.task-action {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brand);
  flex-shrink: 0;
  margin: 4rpx 0 0 12rpx;
}

/* ============ 里程碑 / 每日例行 ============ */
.milestone-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #eef1f6;
}

.milestone-item:last-child {
  border-bottom: none;
}

.milestone-day {
  background: var(--brand-bg);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.milestone-content {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.milestone-past {
  opacity: 0.6;
}

.milestone-past .milestone-day {
  background: #f0fbe4;
  color: var(--success);
}

.routine-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.routine-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand);
  flex-shrink: 0;
  margin: 16rpx 16rpx 0 0;
}

.routine-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.plan-tips {
  margin-top: 20rpx;
  background: var(--brand-bg);
  border-left: 6rpx solid var(--brand);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.empty-tip {
  font-size: 26rpx;
  color: var(--text-hint);
  text-align: center;
  padding: 24rpx 0;
}
