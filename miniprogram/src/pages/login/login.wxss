/* 登录页面样式 */
.container {
  min-height: 100vh;
  background:
    radial-gradient(1200rpx 600rpx at 110% -10%, rgba(22, 119, 255, 0.08), transparent),
    linear-gradient(180deg, #eaf3ff 0%, #f4f6fa 40%);
  display: flex;
  flex-direction: column;
  padding: 0;
}

/* ============ 品牌渐变头部 ============ */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  border-radius: 0 0 48rpx 48rpx;
  padding: 100rpx 48rpx 140rpx;
  box-shadow: 0 12rpx 36rpx rgba(22, 119, 255, 0.25);
}

/* 装饰光斑 */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -120rpx;
  right: -80rpx;
}

.deco-2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -60rpx;
  left: 60rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-ring {
  width: 176rpx;
  height: 176rpx;
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  padding: 12rpx;
  margin-bottom: 32rpx;
  backdrop-filter: blur(4rpx);
}

.logo {
  width: 148rpx;
  height: 148rpx;
  border-radius: 40rpx;
  display: block;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 28rpx;
}

.hero-feature {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
}

.feature-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.8;
}

.feature-text {
  font-size: 24rpx;
  color: #fff;
  letter-spacing: 1rpx;
}

/* ============ 登录面板（浮起） ============ */
.login-body {
  position: relative;
  z-index: 2;
  margin: -84rpx 40rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(20, 45, 90, 0.10);
}

/* 微信登录按钮 */
.btn-wx-login {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2ad46b 0%, #07c160 50%, #059a4c 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.32);
}

.btn-wx-login::after {
  border: none;
}

.btn-wx-login:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.wx-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}

/* 分割线 */
.divider-text {
  display: flex;
  align-items: center;
  margin: 44rpx 0 36rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e3e8ef, transparent);
}

.divider-text-inner {
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

/* 账号登录 */
.account-login {
  background: #f8fafd;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
  margin-bottom: 14rpx;
}

.input {
  width: 100%;
  height: 92rpx;
  background: #fff;
  border: 2rpx solid #e8ecf2;
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.2s ease;
}

.input-placeholder {
  color: #b8c0cc;
}

.btn-account-login {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 46rpx;
  border: none;
  margin-top: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);
}

.btn-account-login::after {
  border: none;
}

.btn-account-login:active {
  transform: scale(0.97);
  opacity: 0.92;
}

/* ============ 底部协议 ============ */
.login-footer {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  padding: 48rpx 40rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.agreement {
  color: var(--text-hint);
}

.footer-divider {
  margin: 0 16rpx;
  color: #d8dee7;
}

.link {
  color: var(--brand);
}
