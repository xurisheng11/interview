<view class="container">
  <!-- 通用设置 -->
  <view class="section">
    <text class="section-title">通用设置</text>
    
    <view class="setting-item" bindtap="toggleNotification">
      <view class="item-left">
        <text class="item-icon">🔔</text>
        <text class="item-label">消息通知</text>
      </view>
      <switch 
        checked="{{settings.notification}}"
        bindchange="onNotificationChange"
        color="#1890ff"
      />
    </view>

    <view class="setting-item" bindtap="toggleSound">
      <view class="item-left">
        <text class="item-icon">🔊</text>
        <text class="item-label">声音</text>
      </view>
      <switch 
        checked="{{settings.sound}}"
        bindchange="onSoundChange"
        color="#1890ff"
      />
    </view>

    <view class="setting-item" bindtap="toggleVibration">
      <view class="item-left">
        <text class="item-icon">📳</text>
        <text class="item-label">震动</text>
      </view>
      <switch 
        checked="{{settings.vibration}}"
        bindchange="onVibrationChange"
        color="#1890ff"
      />
    </view>
  </view>

  <!-- 隐私设置 -->
  <view class="section">
    <text class="section-title">隐私设置</text>
    
    <view class="setting-item" bindtap="viewPrivacy">
      <view class="item-left">
        <text class="item-icon">🔒</text>
        <text class="item-label">隐私政策</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="setting-item" bindtap="viewTerms">
      <view class="item-left">
        <text class="item-icon">📄</text>
        <text class="item-label">用户协议</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <text class="section-title">数据管理</text>
    
    <view class="setting-item" bindtap="clearCache">
      <view class="item-left">
        <text class="item-icon">🗑️</text>
        <text class="item-label">清除缓存</text>
      </view>
      <view class="item-right">
        <text class="cache-size">{{cacheSize}}</text>
        <text class="arrow">></text>
      </view>
    </view>

    <view class="setting-item" bindtap="exportData">
      <view class="item-left">
        <text class="item-icon">📤</text>
        <text class="item-label">导出数据</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <text class="section-title">关于</text>
    
    <view class="setting-item" bindtap="checkUpdate">
      <view class="item-left">
        <text class="item-icon">🔄</text>
        <text class="item-label">检查更新</text>
      </view>
      <view class="item-right">
        <text class="version">v{{version}}</text>
        <text class="arrow">></text>
      </view>
    </view>

    <view class="setting-item" bindtap="viewAbout">
      <view class="item-left">
        <text class="item-icon">ℹ️</text>
        <text class="item-label">关于我们</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="btn-logout" bindtap="logout">退出登录</button>
  </view>
</view>
