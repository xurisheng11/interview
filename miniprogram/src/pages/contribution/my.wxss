/* 我的贡献页 */

/* 统计卡片 */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: var(--shadow-card);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand);
}

.stat-value.verified { color: var(--brand-dark); }
.stat-value.approved { color: #52c41a; }
.stat-value.pending { color: #d48806; }

.stat-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

/* 积分条 */
.credit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #555;
  box-shadow: var(--shadow-card);
}

.credit-num {
  color: var(--brand);
  font-size: 32rpx;
  font-weight: 700;
}

.credit-btn {
  background: var(--gradient-brand);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

/* 贡献卡片 */
.contribution-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.c-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.c-company {
  font-weight: 700;
  font-size: 28rpx;
  color: #333;
}

.c-job {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}

.c-content {
  font-size: 26rpx;
  color: #444;
  line-height: 1.7;
  margin-top: 14rpx;
}

.c-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.mini-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

.mini-tag.diff-success { background: #f6ffed; color: #52c41a; }
.mini-tag.diff-warning { background: #fff7e6; color: #d48806; }
.mini-tag.diff-danger { background: #fff1f0; color: #ff4d4f; }

.c-year {
  font-size: 22rpx;
  color: #999;
}

.c-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f5f5f5;
}

.c-stats {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #888;
}

.c-date {
  font-size: 22rpx;
  color: #999;
}

/* 状态标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.tag-warning { background: #fff7e6; color: #d48806; }
.tag-success { background: #f6ffed; color: #52c41a; }
.tag-primary { background: var(--brand-light); color: var(--brand); }
.tag-danger { background: #fff1f0; color: #ff4d4f; }
.tag-info { background: #f5f5f5; color: #888; }

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #555;
  margin: 24rpx 0 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-state .btn-primary {
  width: 60%;
}

.loading-wrap {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}

/* 底部链接 */
.bottom-link {
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  margin-bottom: 40rpx;
  box-shadow: var(--shadow-card);
}
