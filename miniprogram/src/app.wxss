/* app.wxss - 全局设计系统 */

/* ============ 设计变量 ============ */
page {
  /* 品牌色系 */
  --brand: #1677ff;
  --brand-light: #4096ff;
  --brand-dark: #0958d9;
  --brand-bg: #e8f3ff;

  /* 功能色系 */
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;
  --purple: #722ed1;
  --cyan: #13c2c2;
  --pink: #eb2f96;

  /* 文本色系 */
  --text-main: #1a1a2e;
  --text-sub: #5c6470;
  --text-hint: #9aa3af;

  /* 品牌渐变 */
  --gradient-brand: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  --gradient-green: linear-gradient(135deg, #73d13d 0%, #389e0d 100%);
  --gradient-orange: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  --gradient-purple: linear-gradient(135deg, #b37feb 0%, #531dab 100%);
  --gradient-cyan: linear-gradient(135deg, #5cdbd3 0%, #08979c 100%);
  --gradient-pink: linear-gradient(135deg, #ff85c0 0%, #c41d7f 100%);

  /* 阴影体系 */
  --shadow-card: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  --shadow-card-lg: 0 10rpx 40rpx rgba(20, 45, 90, 0.10);
  --shadow-brand: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-main);
  background-color: #f4f6fa;
}

/* ============ 通用容器 ============ */
.container {
  padding: 24rpx;
}

/* ============ 卡片 ============ */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

/* 卡片按压态（配合 wxml hover-class 使用） */
.card-pressed {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(20, 45, 90, 0.08);
  transition: all 0.15s ease;
}

/* ============ 按钮 ============ */
.btn-primary {
  background: var(--gradient-brand);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 56rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: var(--shadow-brand);
  letter-spacing: 2rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.btn-secondary {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(22, 119, 255, 0.45);
  border-radius: 48rpx;
  padding: 26rpx 56rpx;
  font-size: 32rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: var(--brand-bg);
}

/* ============ 区块标题（带品牌强调条） ============ */
.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--gradient-brand);
  margin-right: 16rpx;
}

/* ============ 文本 ============ */
.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* ============ 分割线 ============ */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #e8ecf2, transparent);
  margin: 32rpx 0;
}

/* ============ 空状态 ============ */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-bottom: 32rpx;
}

/* ============ 加载状态 ============ */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-hint);
}

/* ============ 标签 ============ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.5;
}

.tag-primary {
  background: var(--brand-bg);
  color: var(--brand);
}

.tag-success {
  background: #f0fbe4;
  color: var(--success);
}

.tag-warning {
  background: #fff7e0;
  color: #ef9400;
}

.tag-default {
  background: #f2f4f7;
  color: var(--text-sub);
}

/* ============ 通用图标容器（渐变圆角方块） ============ */
.icon-cube {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: inset 0 -4rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* ============ 安全区 ============ */
.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* ============ 入场动画 ============ */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.anim-fade-in {
  animation: fadeInUp 0.4s ease both;
}
