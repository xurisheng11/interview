/* 贡献面试题页 */

/* 顶部横幅 */
.hero {
  background: var(--gradient-brand);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.hero-sub {
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
  margin-bottom: 24rpx;
}

.credit-box {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
}

.credit-num {
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 8rpx;
}

/* 表单 */
.form-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item-half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 14rpx;
}

.required {
  color: #ff4d4f;
  margin-right: 6rpx;
}

.form-input {
  background: var(--bg-input, #f5f7fa);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.input-placeholder {
  color: #b0b7c3;
}

.form-picker {
  background: var(--bg-input, #f5f7fa);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-picker .placeholder {
  color: #b0b7c3;
}

.picker-arrow {
  color: #b0b7c3;
  font-size: 30rpx;
}

/* 题目列表 */
.questions-section {
  border: 2rpx dashed #d9e2ef;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  background: #fafbfd;
}

.question-item {
  background: #fff;
  border: 2rpx solid #e8eef7;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.q-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.q-num {
  font-weight: 600;
  font-size: 26rpx;
  color: var(--brand);
}

.q-remove {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 6rpx 12rpx;
}

.q-textarea {
  width: 100%;
  min-height: 140rpx;
  background: var(--bg-input, #f5f7fa);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.q-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.meta-chip {
  background: var(--brand-light);
  color: var(--brand);
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

.q-tags-input {
  margin-top: 16rpx;
  background: var(--bg-input, #f5f7fa);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #333;
}

.add-btn {
  text-align: center;
  border: 2rpx dashed var(--brand);
  color: var(--brand);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.submit-btn {
  width: 100%;
  margin-top: 8rpx;
}

/* 积分规则 */
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #555;
}

.rule-credit {
  color: var(--brand);
  font-weight: 700;
}

/* 最近贡献 */
.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.link-more {
  font-size: 24rpx;
  color: var(--brand);
}

.contribution-item {
  border: 2rpx solid #eef2f8;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.c-company {
  font-weight: 600;
  font-size: 26rpx;
  color: #333;
}

.c-content {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-meta {
  margin-top: 12rpx;
}

/* 状态标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.tag-warning { background: #fff7e6; color: #d48806; }
.tag-success { background: #f6ffed; color: #52c41a; }
.tag-primary { background: var(--brand-light); color: var(--brand); }
.tag-danger { background: #fff1f0; color: #ff4d4f; }
.tag-info { background: #f5f5f5; color: #888; }

/* 指南 */
.guide-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.guide-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.7;
}

/* 底部链接 */
.bottom-links {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.link-btn {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 500;
  box-shadow: var(--shadow-card);
}

/* 选择弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-popup {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.popup-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.popup-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}

.popup-option {
  background: var(--bg-input, #f5f7fa);
  border-radius: 12rpx;
  padding: 20rpx 44rpx;
  font-size: 28rpx;
  color: #333;
}

.popup-cancel {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 16rpx;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 32rpx 0;
}
