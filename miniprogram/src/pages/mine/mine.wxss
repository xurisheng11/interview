/* 我的页面样式 */
.container {
  padding: 24rpx;
}

/* ============ 用户卡片（品牌渐变） ============ */
.user-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  border-radius: 28rpx;
  padding: 44rpx 36rpx 56rpx;
  margin-bottom: -28rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.28);
  transition: transform 0.15s ease;
}

.user-card.unlogin {
  margin-bottom: 0;
  padding: 44rpx 36rpx;
}

.user-card-pressed {
  transform: scale(0.98);
}

/* 装饰光斑 */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.deco-1 {
  width: 260rpx;
  height: 260rpx;
  top: -110rpx;
  right: -60rpx;
}

.deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -60rpx;
  right: 180rpx;
  background: rgba(255, 255, 255, 0.08);
}

.user-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

/* 头像白色描边 */
.avatar-ring {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.35);
  margin-right: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: block;
}

.avatar-placeholder {
  position: relative;
  z-index: 1;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  border: 2rpx dashed rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

/* 右侧编辑入口 */
.arrow-badge {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
}

.arrow {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.edit-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.unlogin .nickname,
.unlogin .desc {
  color: #fff;
}

/* ============ 统计卡片（叠加在渐变卡下沿） ============ */
.stats-card {
  position: relative;
  z-index: 2;
  padding: 36rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(20, 45, 90, 0.10);
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  transition: background 0.15s ease;
}

.stat-pressed {
  background: #f4f7fc;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1f6;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.v-blue {
  color: var(--brand);
}

.v-green {
  color: var(--success);
}

.v-orange {
  color: #ef9400;
}

.v-purple {
  color: var(--purple);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 10rpx;
}

/* ============ 菜单卡片 ============ */
.menu-card {
  padding: 8rpx 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  transition: background 0.15s ease;
}

.menu-pressed {
  background: #f4f7fc;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #fff;
  margin-right: 24rpx;
  position: relative;
}

/* 图标顶部光泽 */
.menu-icon::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 10rpx;
  width: 24rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  transform: rotate(-20deg);
}

.icon-history {
  background: linear-gradient(135deg, #52a9ff 0%, #0958d9 100%);
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, 0.25);
}

.icon-star {
  background: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  box-shadow: 0 6rpx 16rpx rgba(250, 173, 20, 0.25);
}

.icon-contribute {
  background: linear-gradient(135deg, #73d13d 0%, #389e0d 100%);
  box-shadow: 0 6rpx 16rpx rgba(82, 196, 26, 0.25);
}

.icon-resume {
  background: linear-gradient(135deg, #ff9c6e 0%, #d4380d 100%);
  box-shadow: 0 6rpx 16rpx rgba(250, 84, 28, 0.25);
}

.icon-learn {
  background: linear-gradient(135deg, #85a5ff 0%, #2f54eb 100%);
  box-shadow: 0 6rpx 16rpx rgba(47, 84, 235, 0.25);
}

.icon-community {
  background: linear-gradient(135deg, #5cdbd3 0%, #08979c 100%);
  box-shadow: 0 6rpx 16rpx rgba(19, 194, 194, 0.25);
}

.icon-company {
  background: linear-gradient(135deg, #b37feb 0%, #531dab 100%);
  box-shadow: 0 6rpx 16rpx rgba(114, 46, 209, 0.25);
}

.icon-bank {
  background: linear-gradient(135deg, #ffd666 0%, #ad6800 100%);
  box-shadow: 0 6rpx 16rpx rgba(212, 136, 6, 0.25);
}

.icon-settings {
  background: linear-gradient(135deg, #b37feb 0%, #531dab 100%);
  box-shadow: 0 6rpx 16rpx rgba(114, 46, 209, 0.25);
}

.icon-help {
  background: linear-gradient(135deg, #5cdbd3 0%, #08979c 100%);
  box-shadow: 0 6rpx 16rpx rgba(19, 194, 194, 0.25);
}

.icon-about {
  background: linear-gradient(135deg, #ff85c0 0%, #c41d7f 100%);
  box-shadow: 0 6rpx 16rpx rgba(235, 47, 150, 0.25);
}

.menu-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.arrow {
  font-size: 36rpx;
  color: #c5ccd6;
}

/* ============ 退出登录按钮 ============ */
.btn-logout {
  width: 100%;
  height: 92rpx;
  background: #fff;
  color: var(--danger);
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 46rpx;
  border: none;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
  box-shadow: var(--shadow-card);
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background: #fff1f0;
  transform: scale(0.98);
}

/* 登录提示 */
.login-prompt {
  margin-bottom: 24rpx;
}
