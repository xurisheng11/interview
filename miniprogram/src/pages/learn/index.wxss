/* 学习中心首页样式 */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 24rpx 48rpx;
}

/* ============ 按压反馈 ============ */
.btn-press {
  transform: scale(0.97);
  opacity: 0.92;
}

/* ============ 冲刺计划入口 ============ */
.sprint-banner {
  display: flex;
  align-items: center;
  background: var(--gradient-brand);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-card-lg);
}

.sprint-banner-main {
  flex: 1;
  min-width: 0;
}

.sprint-banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sprint-banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
  margin-top: 10rpx;
}

/* 计划进度条 */
.sprint-progress {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.sprint-progress-bar {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.sprint-progress-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

.sprint-banner-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sprint-banner-btn {
  background: #fff;
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ============ 学习路径 ============ */
.path-intro {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.stage-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.stage-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.stage-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.stage-basic {
  background: var(--gradient-green);
}

.stage-intermediate {
  background: var(--gradient-brand);
}

.stage-advanced {
  background: var(--gradient-purple);
}

.stage-info {
  flex: 1;
  min-width: 0;
}

.stage-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.stage-duration {
  font-size: 24rpx;
  color: var(--brand);
  margin-top: 6rpx;
}

.stage-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 学习主题 */
.topic-item {
  background: #f7f9fc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.topic-item:last-child {
  margin-bottom: 0;
}

.topic-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.topic-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.topic-difficulty {
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.topic-difficulty.easy {
  background: #f0fbe4;
  color: var(--success);
}

.topic-difficulty.medium {
  background: #fff7e0;
  color: #ef9400;
}

.topic-difficulty.hard {
  background: #fff1f0;
  color: var(--danger);
}

.topic-desc {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

/* ============ 备考建议 ============ */
.tip-card {
  background: var(--brand-bg);
  border-left: 8rpx solid var(--brand);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.7;
}
