/* 个人资料编辑页样式 */
.container {
  min-height: 100vh;
  background: #f4f6fa;
  padding-bottom: 200rpx;
}

/* ============ 头像区域（品牌渐变头部） ============ */
.avatar-section {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0 64rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.22);
}

/* 装饰光斑 */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.deco-1 {
  width: 240rpx;
  height: 240rpx;
  top: -100rpx;
  right: -50rpx;
}

.deco-2 {
  width: 140rpx;
  height: 140rpx;
  bottom: -50rpx;
  left: 50rpx;
  background: rgba(255, 255, 255, 0.08);
}

.avatar-wrapper {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  margin-bottom: 20rpx;
  transition: transform 0.15s ease;
}

.avatar-pressed {
  transform: scale(0.95);
}

.avatar {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.4);
  box-sizing: border-box;
  display: block;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #ffc53d 0%, #d48806 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(250, 173, 20, 0.35);
  font-size: 22rpx;
}

.avatar-tip {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ============ 信息区块 ============ */
.section {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 45, 90, 0.06);
  overflow: hidden;
}

.input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #f2f4f7;
  transition: background 0.15s ease;
}

.input-row:last-child {
  border-bottom: none;
}

.row-pressed {
  background: #f4f7fc;
}

.row-left {
  display: flex;
  align-items: center;
}

.row-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-main);
}

.row-right {
  display: flex;
  align-items: center;
}

.row-value {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-right: 12rpx;
}

.row-value.bio-text {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 36rpx;
  color: #c5ccd6;
  line-height: 1;
}

/* ============ 底部保存按钮 ============ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 -4rpx 24rpx rgba(20, 45, 90, 0.08);
}

.btn-save {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #52a9ff 0%, #1677ff 48%, #0958d9 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 46rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.32);
}

.btn-save::after {
  border: none;
}

.btn-save:active {
  transform: scale(0.97);
  opacity: 0.92;
}
