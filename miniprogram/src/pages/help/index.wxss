/* 帮助与反馈页面样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 48rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  padding: 28rpx 32rpx 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* FAQ 列表 */
.faq-list {
  background: #fff;
}

.faq-item {
  border-bottom: 1px solid #f5f5f5;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
}

.faq-q {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.faq-arrow {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 16rpx;
}

.faq-answer {
  padding: 0 32rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
  background: #fafafa;
}

/* 教程列表 */
.tutorial-list {
  background: #fff;
}

.tutorial-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid #f5f5f5;
}

.tutorial-item:last-child {
  border-bottom: none;
}

.tutorial-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.tutorial-content {
  flex: 1;
}

.tutorial-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.tutorial-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 反馈表单 */
.feedback-form {
  background: #fff;
  padding: 24rpx 32rpx;
}

.feedback-input {
  width: 100%;
  height: 200rpx;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.feedback-input::placeholder {
  color: #bbb;
}

.feedback-footer {
  text-align: right;
  padding: 12rpx 0 24rpx;
}

.char-count {
  font-size: 24rpx;
  color: #999;
}

.btn-submit {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
}

/* 联系客服 */
.contact-list {
  background: #fff;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid #f5f5f5;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-left {
  display: flex;
  align-items: center;
}

.contact-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.contact-label {
  font-size: 28rpx;
  color: #333;
}

.contact-value {
  font-size: 26rpx;
  color: #999;
}
