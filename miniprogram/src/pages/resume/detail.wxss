/* 简历详情页面样式 */
.container {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.loading,
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-hint);
}

.btn-back {
  margin-top: 32rpx;
  width: 320rpx;
  height: 80rpx;
  background: #fff;
  color: var(--brand);
  border: 2rpx solid rgba(22, 119, 255, 0.45);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-back::after {
  border: none;
}

/* ============ 文件信息卡片 ============ */
.info-card {
  margin-bottom: 24rpx;
}

.resume-header {
  display: flex;
  align-items: center;
}

.resume-icon-lg-wrap {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafd;
  border-radius: 24rpx;
  margin-right: 24rpx;
}

.resume-icon-lg {
  font-size: 56rpx;
}

.resume-meta {
  flex: 1;
  min-width: 0;
}

.resume-filename-lg {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resume-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: #f2f4f7;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 状态标签 */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: currentColor;
}

.status-tag.pending {
  background: #fff7e0;
  color: #ef9400;
}

.status-tag.analyzing {
  background: #fff7e0;
  color: #ef9400;
}

.status-tag.done {
  background: #f0fbe4;
  color: var(--success);
}

.status-tag.failed {
  background: #fff1f0;
  color: var(--danger);
}

/* ============ 区块卡片 ============ */
.section-card {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--gradient-brand);
  margin-right: 16rpx;
}

.subsection-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  margin-top: 32rpx;
}

/* 重新分析按钮 */
.btn-retry {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  background: #fff7e0;
  color: #ef9400;
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.btn-retry::after {
  border: none;
}

.btn-press {
  transform: scale(0.96);
  opacity: 0.88;
}

/* ============ 分析状态占位 ============ */
.status-box {
  text-align: center;
  padding: 60rpx 20rpx;
}

.status-box-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.status-box-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-hint);
}

.status-box-text-fail {
  color: var(--danger);
}

/* ============ 总分展示（评分环 + 侧栏） ============ */
.score-hero {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding: 36rpx 8rpx;
}

.score-ring {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
  border: 12rpx solid #e8ecf2;
  background: radial-gradient(circle at 50% 38%, #f6f9ff 0%, #ffffff 72%);
  box-shadow: 0 12rpx 32rpx rgba(20, 45, 90, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-ring-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.score-line-num {
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--text-main);
}

.score-line-unit {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-left: 6rpx;
}

.score-grade {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

/* 环色随分数等级 */
.score-ring.score-high {
  border-color: var(--success);
  background: radial-gradient(circle at 50% 38%, #f2fbec 0%, #ffffff 72%);
}
.score-ring.score-high .score-line-num,
.score-ring.score-high .score-grade { color: var(--success); }

.score-ring.score-mid {
  border-color: var(--brand);
  background: radial-gradient(circle at 50% 38%, #f0f7ff 0%, #ffffff 72%);
}
.score-ring.score-mid .score-line-num,
.score-ring.score-mid .score-grade { color: var(--brand); }

.score-ring.score-low {
  border-color: #ef9400;
  background: radial-gradient(circle at 50% 38%, #fff7e8 0%, #ffffff 72%);
}
.score-ring.score-low .score-line-num,
.score-ring.score-low .score-grade { color: #ef9400; }

.score-ring.score-none { border-color: #e8ecf2; }
.score-ring.score-none .score-line-num { color: #c5ccd6; }

.score-hero-side {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.score-hero-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.score-hero-dim {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

/* ============ 维度评分 ============ */
.dimensions-section {
  margin-top: 16rpx;
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dimension-item {
  padding: 0;
}

.dimension-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.dimension-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-sub);
}

.dimension-score {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand);
}

.dimension-bar {
  height: 14rpx;
  background: #eef1f6;
  border-radius: 999rpx;
  overflow: hidden;
}

.dimension-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--gradient-brand);
  transition: width 0.6s ease;
}

/* ============ 改进建议 ============ */
.suggestions-section {
  margin-top: 16rpx;
}

.suggestions-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.suggestion-item {
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  border-left: 6rpx solid var(--brand);
  background: #f8fafd;
  border-radius: 0 12rpx 12rpx 0;
  line-height: 1.7;
}

/* ============ 简历内容摘要 ============ */
.content-section {
  margin-bottom: 32rpx;
}

.content-section:last-child {
  margin-bottom: 0;
}

.content-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

.content-value {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 技能标签 */
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.skill-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  background: var(--brand-bg);
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 经历条目 */
.entry-item {
  padding: 20rpx 24rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background: #fafbfc;
}

.entry-item:last-child {
  margin-bottom: 0;
}

.entry-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.entry-role {
  font-size: 26rpx;
  color: var(--text-hint);
  font-weight: 400;
}

.entry-duration,
.entry-stack {
  display: block;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-bottom: 6rpx;
}

.entry-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ============ 操作区域 ============ */
.action-card {
  margin-bottom: 24rpx;
}

/* 主行动卡片：开始简历面试 */
.btn-start {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: var(--gradient-brand);
  box-shadow: 0 12rpx 32rpx rgba(22, 119, 255, 0.28);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-start-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.btn-start-icon-wrap {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-start-emoji {
  font-size: 40rpx;
}

.btn-start-texts {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.btn-start-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.btn-start-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.btn-start-arrow {
  flex-shrink: 0;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 0 8rpx;
}

.btn-start-press {
  transform: scale(0.985);
  opacity: 0.92;
}

.btn-start.disabled {
  background: #dfe6ef;
  box-shadow: none;
}

.btn-start.disabled .btn-start-title { color: #8a94a3; }
.btn-start.disabled .btn-start-sub { color: #a5aebc; }
.btn-start.disabled .btn-start-icon-wrap { background: #d3dbe6; }
.btn-start.disabled .btn-start-arrow { color: #b6bfcc; }

/* 删除：弱操作文字链 */
.btn-delete {
  margin-top: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--text-hint);
  border-radius: 16rpx;
}

.btn-delete-press {
  color: var(--danger);
  background: #fff1f0;
}
