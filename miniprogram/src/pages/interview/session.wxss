/* 面试进行页样式 */
.container {
  min-height: 100vh;
  background: #1a1a1a;
  padding: 0 0 200rpx 0;
  box-sizing: border-box;
}

/* 顶部进度条 */
.progress-bar {
  padding: 24rpx 32rpx;
  background: #2a2a2a;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.timer-text {
  font-size: 32rpx;
  color: #1890ff;
  font-weight: 600;
  font-family: monospace;
}

.progress-track {
  height: 8rpx;
  background: #3a3a3a;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff 0%, #52c41a 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 问题卡片 */
.question-card {
  margin: 24rpx 32rpx;
  background: #2a2a2a;
  border-radius: 24rpx;
  padding: 32rpx;
}

.question-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.question-type-tag {
  padding: 8rpx 20rpx;
  background: #1890ff;
  border-radius: 8rpx;
}

.question-type-tag text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.question-difficulty {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.question-difficulty.easy {
  background: #d9f7be;
  color: #52c41a;
}

.question-difficulty.medium {
  background: #ffe58f;
  color: #faad14;
}

.question-difficulty.hard {
  background: #ffccc7;
  color: #ff4d4f;
}

.question-content {
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  color: #fff;
  line-height: 1.6;
  font-weight: 500;
}

.question-hint {
  display: flex;
  align-items: flex-start;
  background: #3a3a3a;
  border-radius: 12rpx;
  padding: 20rpx;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.5;
}

/* 答案输入区 */
.answer-section {
  margin: 0 32rpx 24rpx 32rpx;
}

.answer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.answer-label {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.answer-tips {
  font-size: 24rpx;
  color: #888;
}

.answer-input {
  width: 100%;
  height: 280rpx;
  padding: 24rpx;
  background: #2a2a2a;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #fff;
  line-height: 1.6;
  box-sizing: border-box;
}

.answer-input::placeholder {
  color: #666;
}

.answer-input.recording {
  border: 2rpx solid #ff4d4f;
}

.answer-footer {
  text-align: right;
  padding: 12rpx 0;
}

.char-count {
  font-size: 24rpx;
  color: #666;
}

/* 录音区域 */
.record-section {
  margin: 0 32rpx 32rpx 32rpx;
  padding: 24rpx;
  background: #2a2a2a;
  border-radius: 16rpx;
}

.record-hint {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 24rpx;
}

.recording-hint {
  color: #ff4d4f;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ff4d4f;
  border-radius: 50%;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.record-time {
  font-family: monospace;
  font-size: 28rpx;
}

.record-actions {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.btn-record {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: none;
  background: #3a3a3a;
}

.btn-record.start {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
}

.btn-record.stop {
  background: linear-gradient(135deg, #666 0%, #888 100%);
}

.record-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.record-label {
  font-size: 24rpx;
  color: #fff;
}

.btn-play {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 32rpx;
  background: #1890ff;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
  border: none;
}

.btn-play.disabled {
  opacity: 0.5;
}

/* 底部操作区 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #2a2a2a;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.btn-prev, .btn-next {
  min-width: 180rpx;
  height: 88rpx;
  background: #3a3a3a;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-prev.disabled {
  opacity: 0.4;
}

.btn-next {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.btn-center {
  flex: 1;
  display: flex;
  justify-content: center;
}

.btn-skip {
  padding: 16rpx 32rpx;
  background: transparent;
  border: 2rpx solid #555;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #888;
}

/* 完成弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  padding: 60rpx 40rpx;
  background: #2a2a2a;
  border-radius: 24rpx;
  text-align: center;
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.modal-desc {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 32rpx;
}

.modal-progress {
  height: 8rpx;
  background: #3a3a3a;
  border-radius: 4rpx;
  overflow: hidden;
}

.modal-progress-bar {
  height: 100%;
  width: 30%;
  background: linear-gradient(90deg, #1890ff 0%, #52c41a 100%);
  border-radius: 4rpx;
  animation: loading 1.5s ease-in-out infinite;
}

@keyframes loading {
  0% { width: 0%; margin-left: 0; }
  50% { width: 60%; margin-left: 20%; }
  100% { width: 0%; margin-left: 100%; }
}
